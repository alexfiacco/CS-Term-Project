+/// What we've learned (owner-approved 2026-11-12, CS-Term-Project mockups/journeys/b69-what-weve-learned-v2.png frames
+/// b to f and b70-learned-entry.png option A; rules 1780 to 1783; the web's LearnedPage and LearnedSetting). A pushed
+/// screen in the menu's stack (it replaced `LearnedDrawer`), opened from Settings › Tune for you's first row, the
+/// menu's row under Settings and the Taste tab's "What we've learned" link. GET/POST /api/learned.
+enum Learned {
+    /// One chip: a lean ("strand:", "person:", "lang:", "era:", "genre:") or a film chip they told us ("chip:").
+    struct Lean: Decodable, Identifiable, Hashable, Sendable {
+        let id: String
+        let kind: String
+        let label: String
+        let from: String
+    }
+    struct Page: Decodable, Sendable {
+        let rated: Int
+        let need: Int
+        let summary: String?
+        let into: [Lean]
+        let near: [Lean]
+    }
+    struct Item: Decodable, Identifiable, Sendable {
+        struct Film: Decodable, Sendable { let slug: String; let title: String }
+        let id: String
+        let kind: String
+        let label: String
+        let line: String
+        let polarity: String
+        let films: [Film]?
+    }
+    struct Payload: Decodable, Sendable { let items: [Item]?; let page: Page? }
+
+    static func load() async -> Payload? {
+        guard let token = try? await Backend.supabase.auth.session.accessToken else { return nil }
+        return try? await APIClient(bearer: token).get("/api/learned", fresh: true, as: Payload.self)
+    }
+    struct Posted: Decodable { let ok: Bool?; let to: String? }
+    static func post(_ body: [String: Any]) async -> Posted? {
+        guard let token = try? await Backend.supabase.auth.session.accessToken else { return nil }
+        return try? await APIClient(bearer: token).post("/api/learned", body: body, as: Posted.self)
+    }
+
+    /// The Settings row's preview (lib/learned-leans.ts learnedPreview): the first four chips, then "+N".
+    static func preview(_ into: [Lean]) -> String {
+        if into.isEmpty { return "Nothing yet, tap to add" }
+        let shown = into.prefix(4).map(\.label).joined(separator: ", ")
+        return into.count > 4 ? "\(shown) +\(into.count - 4)" : shown
+    }
+    static func rateMore(_ n: Int) -> String { "Rate \(n) more to see what we've learned" }
+    /// The toast after a chip's × (b69 c).
+    static func muteToast(_ name: String) -> String { "Picks will stop leaning on \(name). Your Film DNA stays the same." }
+    static func icon(_ kind: String) -> Lucide {
+        switch kind { case "strand": .target; case "person": .user; case "lang": .languages; case "era": .calendar; case "genre": .clapperboard; default: .thumbsUp }
+    }
+}
