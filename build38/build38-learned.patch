+"use client";
+
+import { useEffect, useMemo, useRef, useState, type ReactNode } from "react";
+import { ChevronRight, Eye, Download } from "lucide-react";
+import { apiFetch, apiFetchRetry, markLibraryWrite } from "@/lib/auth-headers";
+import { invalidateMyProfile } from "@/lib/my-profile-client";
+import { announcePrefsChanged } from "@/lib/prefs-events";
+import { chipList, polarityOf } from "@/lib/rating-chips";
+import { emitToast, toastDone, toastFailed, TOAST_COPY } from "@/lib/toast";
+import { CONTENT_WARNINGS, NOT_MINE, ALL_LANGUAGE_OPTIONS, notMineName, prefLanguages, type ViewingPrefs } from "@/lib/viewing-prefs";
+import { KIND_ERAS, KIND_GENRES, KIND_MORE_GENRES } from "@/lib/kind-prefs";
+import { muteToast, type LearnedLean } from "@/lib/learned-leans";
+import { BottomDrawer } from "./BottomDrawer";
+import { Icon, type IconName } from "./Icon";
+import { StepBar } from "./SharpenDrawer";
+
+/** GET /api/learned's items (rule 1570) and page (rule 1780). */
+export type LearnedItem = { id: string; kind: "chip" | "soft"; label: string; line: string; polarity: "pos" | "neg"; films?: { slug: string; title: string }[] };
+export type LearnedPageData = { rated: number; need: number; summary: string | null; into: LearnedLean[]; near: LearnedLean[] };
+export type LearnedData = { items: LearnedItem[]; page: LearnedPageData | null };
+
+export async function loadLearned(): Promise<LearnedData | null> {
+  try {
+    const r = await apiFetch("/api/learned", { cache: "no-store" });
+    if (!r.ok) return null;
+    const d = (await r.json()) as Partial<LearnedData>;
+    return { items: d.items ?? [], page: d.page ?? null };
+  } catch { return null; }
+}
+const post = (body: Record<string, unknown>) => apiFetch("/api/learned", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(body) })
+  .then(async (r) => (r.ok ? ((await r.json().catch(() => ({}))) as { ok?: boolean; to?: "kind" | "boost" }) : null)).catch(() => null);
+
+const KIND_ICON: Record<LearnedLean["kind"], IconName> = { strand: "target", person: "user", lang: "languages", era: "calendar", genre: "clapper", told: "thumbsUp" };
+
+/** A solid chip with its kind icon and an × (b69 b; Pitch's chosen chip). A told-us chip's name opens its small menu. */
+function LeanChip({ c, onX, onMenu, never, fading }: { c: { id: string; label: string; kind?: LearnedLean["kind"] }; onX: () => void; onMenu?: () => void; never?: boolean; fading?: boolean }) {
+  const press = useRef<number | null>(null);
+  const hold = onMenu ? {
+    onPointerDown: () => { press.current = window.setTimeout(() => { press.current = null; onMenu(); }, 500); },
+    onPointerUp: () => { if (press.current) window.clearTimeout(press.current); press.current = null; },
+    onPointerLeave: () => { if (press.current) window.clearTimeout(press.current); press.current = null; },
+    onContextMenu: (e: React.MouseEvent) => { e.preventDefault(); onMenu(); },
+  } : {};
+  return (
+    <span className={`recut-chip is-chosen lv-chip${c.kind ? "" : " lv-chip-less"}${fading ? " is-fading" : ""}`} {...hold}>
+      {c.kind && <Icon name={KIND_ICON[c.kind]} size={16} />}
+      {onMenu ? <button type="button" className="lv-chip-name" aria-haspopup="dialog" onClick={onMenu}>{c.label}</button> : c.label}
+      {never && <span className="lv-never">Never</span>}
+      <button type="button" className="recut-chip-x lv-x" aria-label={c.kind ? `Stop leaning on ${c.label}` : `Let ${c.label} back`} onClick={onX}><Icon name="x" className="ico-g" /></button>
+    </span>
+  );
+}
+const OutChip = ({ label, icon = "plus", onClick, busy }: { label: string; icon?: IconName; onClick: () => void; busy?: boolean }) => (
+  <button type="button" className="chip lv-out" onClick={onClick} disabled={busy}><Icon name={icon} size={14} />{label}</button>
+);
+
+/**
+ * What we've learned (owner-approved 2026-11-12, CS-Term-Project mockups/journeys/b69-what-weve-learned-v2.png frames b
+ * to f; rules 1780 to 1782; rule 1570 amended). Its own page in the menu's stack (web ProfileMenu view "learned"; the
+ * iPhone's LearnedScreen), opened from Settings › Tune for you's first row, the menu's row under Settings and the
+ * Taste tab's link under Film DNA. Top down:
+ *  - the Bodoni summary (a template, lib/learned-leans.ts learnedSummary) and "From your ratings ›" to Film DNA;
+ *    under FULL_ARCHETYPE_AT rated, "Rate N more to see what we've learned" with the Sharpen step bar, two shortcut
+ *    rows and the one cream Rate more films (frame f);
+ *  - What you're into: solid chips with a kind icon and an × (POST /api/learned { remove }: the id into learnedOff,
+ *    with the toast "Picks will stop leaning on X. Your Film DNA stays the same." and Undo, { restore });
+ *  - Near your taste: outline + chips ({ add }), then + Add, a search over people, genres, languages and eras;
+ *  - Less of this: Things I'd rather avoid as hard chips marked Never, Show less of as soft ones, the soft skips
+ *    fading, the disliked film chips; + Add opens both lists;
+ *  - Also tuning your picks: services and theaters, languages and region, oldest films, age ratings (`keep`).
+ */
+export function LearnedPage({ keep, onFilmDna, onPicks, onImport, onRate }: {
+  keep: ReactNode; onFilmDna: () => void; onPicks: () => void; onImport: () => void; onRate: () => void;
+}) {
+  const [data, setData] = useState<LearnedData | null>(null);
+  const [failed, setFailed] = useState(false);
+  const [into, setInto] = useState<LearnedLean[]>([]);
+  const [near, setNear] = useState<LearnedLean[]>([]);
+  const [items, setItems] = useState<LearnedItem[]>([]);
+  const [prefs, setPrefs] = useState<ViewingPrefs | null>(null);
+  const [busy, setBusy] = useState(false);
+  const [adding, setAdding] = useState<"into" | "less" | null>(null);
+  const [menu, setMenu] = useState<LearnedItem | null>(null);
+  const load = () => {
+    setFailed(false);
+    void loadLearned().then((d) => {
+      if (!d) { setFailed(true); return; }
+      setData(d); setItems(d.items); setInto(d.page?.into ?? []); setNear(d.page?.near ?? []);
+    });
+    apiFetchRetry("/api/viewing-prefs").then((r) => (r.ok ? r.json() : null)).then((d: { viewingPrefs?: ViewingPrefs } | null) => {
+      if (!d) return;
+      const p: ViewingPrefs = { ...(d.viewingPrefs ?? {}) };
+      const l = prefLanguages(p);
+      delete p.noSubtitles;
+      if (l) p.languages = l;
+      setPrefs(p);
+    }).catch(() => {});
+  };
+  useEffect(load, []);
+  const changed = () => { invalidateMyProfile(); announcePrefsChanged(); };
+
+  const remove = async (c: LearnedLean) => {
+    if (busy) return;
+    const before = into;
+    setInto((xs) => xs.filter((x) => x.id !== c.id));
+    setBusy(true);
+    const r = await post({ remove: c.id });
+    setBusy(false);
+    if (!r?.ok) { setInto(before); toastFailed(); return; }
+    changed();
+    emitToast({ text: muteToast(c.label), undo: () => { setInto(before); void post({ restore: c.id, boost: c.from === "boost" }).then((u) => { if (u?.ok) changed(); else toastFailed(); }); } });
+  };
+  const add = async (c: LearnedLean) => {
+    if (busy || into.some((x) => x.id === c.id)) return;
+    setBusy(true);
+    const r = await post({ add: c.id });
+    setBusy(false);
+    if (!r?.ok) { toastFailed(); return; }
+    setNear((xs) => xs.filter((x) => x.id !== c.id));
+    setInto((xs) => [...xs, { ...c, from: r.to === "kind" ? "kind" : "boost" }]);
+    changed();
+    toastDone(TOAST_COPY.settingsSaved);
+  };
+
+  // Less of: the stored prefs (hard avoid, soft notMine), the soft skips and the disliked film chips.
+  const savePrefs = async (next: ViewingPrefs, undoText?: string) => {
+    if (!prefs || busy) return;
+    const before = prefs;
+    setPrefs(next); setBusy(true);
+    try {
+      const r = await apiFetch("/api/viewing-prefs", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(next) });
+      const d = await r.json().catch(() => ({}));
+      if (!r.ok) { setPrefs(before); toastFailed(); return; }
+      markLibraryWrite(d.at); changed();
+      if (undoText) emitToast({ text: undoText, undo: () => void savePrefsRaw(before) }); else toastDone(TOAST_COPY.settingsSaved);
+    } catch { setPrefs(before); toastFailed(); } finally { setBusy(false); }
+  };
+  const savePrefsRaw = async (p: ViewingPrefs) => {
+    setPrefs(p);
+    const r = await apiFetch("/api/viewing-prefs", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify(p) }).catch(() => null);
+    if (r?.ok) changed(); else toastFailed();
+  };
+  const removeItem = async (it: LearnedItem) => {
+    if (busy) return;
+    const before = items;
+    setItems((xs) => xs.filter((x) => x.id !== it.id));
+    setBusy(true);
+    const r = await post({ remove: it.id });
+    setBusy(false);
+    if (!r?.ok) { setItems(before); toastFailed(); return; }
+    changed();
+    if (it.kind === "chip") emitToast({ text: muteToast(it.label), undo: () => { setItems(before); void post({ restore: it.id }).then((u) => { if (!u?.ok) toastFailed(); else changed(); }); } });
+    else toastDone(TOAST_COPY.settingsSaved);
+  };
+
+  const page = data?.page ?? null;
+  const gate = page && page.need > 0 ? page : null;
+  const softs = items.filter((i) => i.kind === "soft");
+  const negs = items.filter((i) => i.kind === "chip" && i.polarity === "neg");
+  const less = useMemo(() => [
+    ...(prefs?.avoid ?? []).map((k) => ({ id: `avoid:${k}`, key: k, label: CONTENT_WARNINGS.find((w) => w.key === k)?.label ?? k, hard: true })),
+    ...(prefs?.notMine ?? []).map((k) => ({ id: `nm:${k}`, key: k, label: prefs?.notMineNames?.[k] ?? NOT_MINE.find((x) => x.key === k)?.label ?? notMineName(k), hard: false })),
+  ], [prefs]);
+  const lessN = less.length + softs.length + negs.length;
+
+  return (
+    <div className="lv">
+      {failed && !data ? (
+        <p className="pm-retry">What we&apos;ve learned didn&apos;t load. <button type="button" className="pm-retry-btn" onClick={load}>Try again</button></p>
+      ) : !data ? null : gate ? (
+        <section className="lv-top lv-gate">
+          <h2 className="lv-sum lv-sum-gate">Rate {gate.need} more to see what we&apos;ve learned</h2>
+          <StepBar rated={gate.rated} />
+          <p className="lv-lede">At 15 ratings we can say what you&apos;ve been into. Until then, what you picked when you joined is steering your picks.</p>
+          <div className="su-acts lv-acts">
+            <button type="button" className="su-act" onClick={onPicks}><span className="su-act-c" aria-hidden><Eye size={16} strokeWidth={1.75} /></span><span className="su-act-m"><b>Tap Seen it on Picks</b><span>Each one you rate counts</span></span><ChevronRight size={16} strokeWidth={1.75} aria-hidden className="su-act-chev" /></button>
+            <button type="button" className="su-act" onClick={onImport}><span className="su-act-c" aria-hidden><Download size={16} strokeWidth={1.75} /></span><span className="su-act-m"><b>Import your ratings</b><span>Brings them in at once</span></span><ChevronRight size={16} strokeWidth={1.75} aria-hidden className="su-act-chev" /></button>
+          </div>
+          <button type="button" className="btn btn-lg lv-go" onClick={onRate}>Rate more films</button>
+        </section>
+      ) : (
+        <section className="lv-top">
+          <h2 className="lv-sum">{page?.summary ?? "You're still showing us your taste."}</h2>
+          <button type="button" className="lv-from" onClick={onFilmDna}>From your ratings<ChevronRight size={16} strokeWidth={1.75} aria-hidden /></button>
+        </section>
+      )}
+
+      {data && (<>
+        <section className="lv-sec">
+          <h3 className="lv-h">What you&apos;re into</h3>
+          <p className="lv-sub">{gate ? "From what you picked when you joined. Tap × and picks stop leaning on it." : "Picks lean on these. Tap × and they stop. Your Film DNA stays the same."}</p>
+          {into.length > 0 && (
+            <div className="lv-chips">
+              {into.map((c) => {
+                const told = c.kind === "told" ? items.find((i) => i.id === c.id) : undefined;
+                return <LeanChip key={c.id} c={c} onX={() => void remove(c)} onMenu={told ? () => setMenu(told) : undefined} />;
+              })}
+            </div>
+          )}
+          {!gate && near.length > 0 && <div className="lv-k">Near your taste</div>}
+          <div className={`lv-chips${gate || !near.length ? " lv-add-row" : ""}`}>
+            {!gate && near.map((c) => <OutChip key={c.id} label={c.label} onClick={() => void add(c)} busy={busy} />)}
+            <OutChip label="Add" icon="search" onClick={() => setAdding("into")} />
+          </div>
+        </section>
+
+        <section className="lv-sec">
+          <h3 className="lv-h">Less of this</h3>
+          <p className="lv-sub">{lessN ? "Picks, Tonight and Pitch keep to these. Tap × to let them back." : "Nothing yet. Add what you'd rather not see, and Picks, Tonight and Pitch keep to it."}</p>
+          {lessN > 0 && (
+            <div className="lv-chips">
+              {less.map((c) => (
+                <LeanChip key={c.id} c={c} never={c.hard}
+                  onX={() => prefs && void savePrefs(c.hard ? { ...prefs, avoid: (prefs.avoid ?? []).filter((k) => k !== c.key) } : { ...prefs, notMine: (prefs.notMine ?? []).filter((k) => k !== c.key) }, `${c.label} can show up in your picks again.`)} />
+              ))}
+              {negs.map((it) => <LeanChip key={it.id} c={{ id: it.id, label: it.label, kind: "told" }} onX={() => void removeItem(it)} onMenu={() => setMenu(it)} />)}
+              {softs.map((it) => <LeanChip key={it.id} c={{ id: it.id, label: it.label }} fading onX={() => void removeItem(it)} />)}
+            </div>
+          )}
+          <div className="lv-chips lv-add-row"><OutChip label="Add" icon="search" onClick={() => setAdding("less")} /></div>
+        </section>
+      </>)}
+
+      <section className="lv-sec lv-keep">
+        <h3 className="lv-h">Also tuning your picks</h3>
+        {keep}
+      </section>
+      <div className="toast-room" aria-hidden />
+
+      {adding === "into" && <AddDrawer have={new Set(into.map((x) => x.id))} onClose={() => setAdding(null)} onAdd={(c) => void add(c)} />}
+      {adding === "less" && prefs && (
+        <LessDrawer prefs={prefs} busy={busy} onClose={() => setAdding(null)}
+          onAdd={(hard, key) => void savePrefs(hard ? { ...prefs, avoid: [...new Set([...(prefs.avoid ?? []), key])] } : { ...prefs, notMine: [...new Set([...(prefs.notMine ?? []), key])] })} />
+      )}
+      {menu && <ChipMenu it={menu} onClose={() => setMenu(null)} onRemove={() => { const it = menu; setMenu(null); const lean = into.find((x) => x.id === it.id); if (lean) void remove(lean); else void removeItem(it); }}
+        onCorrected={() => { setMenu(null); load(); }} />}
+    </div>
+  );
+}
+
+const ADD_KINDS = [["all", "All"], ["person", "Person"], ["genre", "Genre"], ["lang", "Language"], ["era", "Era"]] as const;
+type AddKind = (typeof ADD_KINDS)[number][0];
+type Found = { id: string; kind: LearnedLean["kind"]; label: string; line: string };
+const GENRES = [...KIND_GENRES, ...KIND_MORE_GENRES];
+const DECADES = [1920, 1930, 1940, 1950, 1960, 1970, 1980, 1990, 2000, 2010, 2020];
+const decadeLabel = (d: number) => (d < 2000 ? `${String(d).slice(2)}s` : `${d}s`);
+
+/** + Add (b69 d): one field, All / Person / Genre / Language / Era. People come from the app's search (directors: the
+ *  picks know a film's directors, not its cast); genres, languages and eras are the app's own lists. */
+function AddDrawer({ have, onClose, onAdd }: { have: Set<string>; onClose: () => void; onAdd: (c: LearnedLean) => void }) {
+  const [q, setQ] = useState("");
+  const [kind, setKind] = useState<AddKind>("all");
+  const [people, setPeople] = useState<Found[]>([]);
+  useEffect(() => {
+    const t = q.trim();
+    if (t.length < 2 || (kind !== "all" && kind !== "person")) { setPeople([]); return; }
+    let live = true;
+    const h = window.setTimeout(() => {
+      apiFetch(`/api/search?q=${encodeURIComponent(t)}`).then((r) => (r.ok ? r.json() : null))
+        .then((d: { people?: { kind: string; name: string; films: number }[] } | null) => {
+          if (!live) return;
+          setPeople((d?.people ?? []).filter((p) => p.kind === "director").slice(0, 6)
+            .map((p) => ({ id: `person:${p.name}`, kind: "person" as const, label: p.name, line: `Director · ${p.films} film${p.films === 1 ? "" : "s"}` })));
+        }).catch(() => {});
+    }, 250);
+    return () => { live = false; window.clearTimeout(h); };
+  }, [q, kind]);
+  const t = q.trim().toLowerCase();
+  const hit = (s: string) => !t || s.toLowerCase().includes(t);
+  const local: Found[] = [
+    ...(kind === "all" || kind === "genre" ? GENRES.filter((g) => hit(g.label)).map((g) => ({ id: `genre:${g.genre}`, kind: "genre" as const, label: g.label, line: "Genre" })) : []),
+    ...(kind === "all" || kind === "lang" ? ALL_LANGUAGE_OPTIONS.filter((l) => l.code !== "en" && hit(l.label)).map((l) => ({ id: `lang:${l.code}`, kind: "lang" as const, label: l.label, line: "Language" })) : []),
+    ...(kind === "all" || kind === "era" ? [...DECADES.map((d) => ({ id: `era:${d}`, kind: "era" as const, label: decadeLabel(d), line: "Era" })),
+      ...KIND_ERAS.filter((e) => e.key === "pre1970").map((e) => ({ id: `era:${e.key}`, kind: "era" as const, label: e.label, line: "Era" }))].filter((e) => hit(e.label)) : []),
+  ];
+  const rows = [...people, ...(t || kind !== "all" ? local : [])].filter((r) => !have.has(r.id)).slice(0, 24);
+  return (
+    <BottomDrawer onClose={onClose} title="Add to what you're into" sub="What we've learned" className="lv-add">
+      <div className="lv-search">
+        <Icon name="search" size={18} />
+        <input className="lv-input" value={q} onChange={(e) => setQ(e.target.value)} placeholder="A director, genre, language or era" aria-label="Search a person, genre, language or era" autoFocus />
+      </div>
+      <div className="lv-chips lv-kinds" role="group" aria-label="What to search">
+        {ADD_KINDS.map(([k, l]) => <button key={k} type="button" className={`chip${kind === k ? " on" : ""}`} aria-pressed={kind === k} onClick={() => setKind(k)}>{l}</button>)}
+      </div>
+      <ul className="lv-res">
+        {rows.map((r) => (
+          <li key={r.id}><button type="button" className="lv-res-row" onClick={() => { onAdd({ id: r.id, kind: r.kind, label: r.label, from: "boost" }); onClose(); }}>
+            <span className="lv-res-av" aria-hidden><Icon name={KIND_ICON[r.kind]} size={16} /></span>
+            <span className="lv-res-m"><b>{r.label}</b><span>{r.line}</span></span>
+            <span className="lv-res-plus" aria-hidden><Icon name="plus" size={18} /></span>
+          </button></li>
+        ))}
+      </ul>
+      <p className="lv-sub lv-add-foot">Picks lean a little toward what you add. Your Film DNA only moves with your ratings.</p>
+    </BottomDrawer>
+  );
+}
+
+/** Less of's + Add: the content you never want (hard, Things I'd rather avoid) and the kinds you want less of (soft, Show less of). */
+function LessDrawer({ prefs, busy, onClose, onAdd }: { prefs: ViewingPrefs; busy: boolean; onClose: () => void; onAdd: (hard: boolean, key: string) => void }) {
+  const [q, setQ] = useState("");
+  const t = q.trim().toLowerCase();
+  const hit = (s: string) => !t || s.toLowerCase().includes(t);
+  const hard = CONTENT_WARNINGS.filter((w) => !(prefs.avoid ?? []).includes(w.key) && hit(w.label));
+  const soft = NOT_MINE.filter((k) => !(prefs.notMine ?? []).includes(k.key) && hit(k.label));
+  return (
+    <BottomDrawer onClose={onClose} title="Add to less of this" sub="What we've learned" className="lv-add">
+      <div className="lv-search">
+        <Icon name="search" size={18} />
+        <input className="lv-input" value={q} onChange={(e) => setQ(e.target.value)} placeholder="Gore, musicals, war..." aria-label="Search what you'd rather not see" />
+      </div>
+      {hard.length > 0 && <>
+        <div className="lv-k">Never show</div>
+        <p className="lv-sub">Picks, Tonight and Pitch leave these out, unless you ask Pitch for them.</p>
+        <div className="lv-chips">{hard.map((w) => <OutChip key={w.key} label={w.label} onClick={() => onAdd(true, w.key)} busy={busy} />)}</div>
+      </>}
+      {soft.length > 0 && <>
+        <div className="lv-k">Show less</div>
+        <p className="lv-sub">Lower in your picks, never hidden.</p>
+        <div className="lv-chips">{soft.map((k) => <OutChip key={k.key} label={k.label} onClick={() => onAdd(false, k.key)} busy={busy} />)}</div>
+      </>}
+    </BottomDrawer>
+  );
+}
+
+/** A told-us chip's small menu (long press, or a tap on its name): Not quite, with that film's own chips (rule 1570), or remove. */
+function ChipMenu({ it, onClose, onRemove, onCorrected }: { it: LearnedItem; onClose: () => void; onRemove: () => void; onCorrected: () => void }) {
+  const [options, setOptions] = useState<{ key: string; label: string }[] | null>(null);
+  const [busy, setBusy] = useState(false);
+  useEffect(() => {
+    const key = it.id.slice(5), pol = polarityOf(key), slug = it.films?.[0]?.slug;
+    if (!slug) { setOptions([]); return; }
+    apiFetch(`/api/rating-chips?slug=${encodeURIComponent(slug)}`).then((r) => r.json()).catch(() => null).then((d: { pos?: string[]; neg?: string[] } | null) => {
+      const { shown, more } = chipList(d?.[pol] ?? [], pol);
+      setOptions([...shown, ...more].map((c) => ({ key: `${c.polarity}:${c.id}`, label: c.label })).filter((o) => o.key !== key));
+    });
+  }, [it]);
+  const correct = async (to: string) => {
+    setBusy(true);
+    const r = await post({ correct: it.id.slice(5), to });
+    setBusy(false);
+    if (r?.ok) { toastDone(TOAST_COPY.settingsSaved); onCorrected(); } else toastFailed();
+  };
+  return (
+    <BottomDrawer onClose={onClose} title={it.label} sub="What we've learned">
+      <p className="bd-lede">{it.line}</p>
+      <div className="lv-k">Not quite? What did you mean</div>
+      <div className="lv-chips">
+        {(options ?? []).map((o) => <button key={o.key} type="button" className="chip lv-out" disabled={busy} onClick={() => void correct(o.key)}>{o.label}</button>)}
+      </div>
+      <div className="lv-chips lv-add-row"><button type="button" className="chip lv-out" onClick={onRemove}><Icon name="x" size={14} />Stop using it</button></div>
+    </BottomDrawer>
+  );
+}
