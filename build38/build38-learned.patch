diff --git a/lib/learned-leans.ts b/lib/learned-leans.ts
new file mode 100644
index 00000000..e9f59a2d
--- /dev/null
+++ b/lib/learned-leans.ts
@@ -0,0 +1,200 @@
+import { KIND_ERAS, KIND_GENRES, KIND_MORE_GENRES, GENRE_PICK_MAX, type KindEra, type KindPrefs } from "./kind-prefs";
+
+/**
+ * What we've learned's leans (owner-approved 2026-11-12, CS-Term-Project mockups/journeys/b69-what-weve-learned-v2.png
+ * frames b to f; rules 1780 to 1782). Pure: the page, the server and the picks share it.
+ *
+ * A lean is one thing the picks lean toward, by id:
+ *   strand:<Strand9Id>   a Film DNA strand lifted above About average (lib/taste/dna-lift.ts)
+ *   person:<name>        a director (directorAffinity), by the name candidate rows carry in `directors`
+ *   lang:<iso 639-1>     a language they love outside their home languages, or one of kind.langs
+ *   era:<decade>|<kind>  a decade they love ("era:1970") or a "Your kind of films" era ("era:7080")
+ *   genre:<TMDB genre>   a genre from kind.genres or their top genres ("genre:Crime")
+ *
+ * Removing one puts its id in viewingPrefs.learnedOff (beside rule 1570's "chip:" ids). A muted lean:
+ *  - drops out of "Your kind of films" where it came from there (effectiveKind: kind.genres, kind.eras, kind.langs),
+ *    so its exact lean (KIND_LEAN_POINTS, the era mix, the chosen-language swap) stops;
+ *  - otherwise (a strand, a director, a language or an era read from ratings) costs a film that carries it
+ *    MUTE_POINTS rank points, MUTE_CAP at most: the taste model's own pull toward it lives inside the match %, which
+ *    never moves here (Film DNA and the % stay the same), so the picks lean back by about one kind lean instead.
+ * Tapping a "Near your taste" chip or adding one adds it: to kind where kind fits (kindFits), else to
+ * viewingPrefs.boost, which lifts a film that carries it BOOST_POINTS, BOOST_CAP at most. Rank only, never the %.
+ */
+export type LeanKind = "strand" | "person" | "lang" | "era" | "genre";
+export const LEAN_KINDS: readonly LeanKind[] = ["strand", "person", "lang", "era", "genre"];
+
+export const STRAND_IDS = ["emotional_realism", "narrative_complexity", "slow_burn", "originality", "visual_style",
+  "visceral_charge", "spectacle", "wonder_imagination", "playful_lightness"] as const;
+export type LeanStrand = (typeof STRAND_IDS)[number];
+
+/** The TMDB genres a genre lean can name (every "Your kind of films" genre). */
+export const LEAN_GENRES: readonly string[] = [...KIND_GENRES, ...KIND_MORE_GENRES].map((g) => g.genre);
+const KIND_ERA_KEYS = new Set<string>(KIND_ERAS.filter((e) => e.key !== "any").map((e) => e.key));
+
+/** Rank points: a muted lean a film carries (counted once per lean), and a boosted one (a lift). */
+export const MUTE_POINTS = 4;
+export const MUTE_CAP = 8;
+export const BOOST_POINTS = 4;
+export const BOOST_CAP = 8;
+/** A film is strong on a strand at this value (filmStrongestStrand9's 60). */
+export const STRAND_STRONG = 60;
+/** Most boosts kept. */
+export const BOOST_MAX = 30;
+
+/** The lean's kind, or null when the id is not a lean (a "chip:" or "soft:" item, or junk). */
+export function leanKind(id: string): LeanKind | null {
+  const m = /^(strand|person|lang|era|genre):(.+)$/.exec(id);
+  if (!m) return null;
+  const v = m[2];
+  switch (m[1]) {
+    case "strand": return (STRAND_IDS as readonly string[]).includes(v) ? "strand" : null;
+    case "person": return v.length <= 80 && !/[\u0000-\u001f]/.test(v) && v.trim() === v ? "person" : null;
+    case "lang": return /^[a-z]{2}$/.test(v) ? "lang" : null;
+    case "era": return /^(1[89]|20)[0-9]0$/.test(v) || KIND_ERA_KEYS.has(v) ? "era" : null;
+    case "genre": return LEAN_GENRES.includes(v) ? "genre" : null;
+  }
+  return null;
+}
+export const isLeanId = (id: unknown): boolean => typeof id === "string" && id.length < 120 && leanKind(id) != null;
+
+/** The years an era lean covers, [from, to] inclusive (open ends as far as they go). */
+export function eraRange(v: string): [number, number] {
+  if (/^\d{4}$/.test(v)) { const d = Number(v); return [d, d + 9]; }
+  const k = KIND_ERAS.find((e) => e.key === v);
+  return [k?.from ?? 0, k?.to ?? 9999];
+}
+/** An era lean's label: "70s", "2000s", or the kind era's own ("70s and 80s"). */
+export function eraLabel(v: string): string {
+  if (/^\d{4}$/.test(v)) { const d = Number(v); return d < 2000 ? `${String(d).slice(2)}s` : `${d}s`; }
+  return KIND_ERAS.find((e) => e.key === v)?.label ?? v;
+}
+
+const genreKey = (genre: string) => [...KIND_GENRES, ...KIND_MORE_GENRES].find((g) => g.genre === genre)?.key;
+
+/** Whether "Your kind of films" holds this lean (so muting it is effectiveKind's job, not MUTE_POINTS'). */
+export function kindCovers(kind: KindPrefs | null | undefined, id: string): boolean {
+  if (!kind) return false;
+  const v = id.slice(id.indexOf(":") + 1);
+  switch (leanKind(id)) {
+    case "genre": { const g = kind.genres ?? []; return g.length <= GENRE_PICK_MAX && g.includes(genreKey(v) ?? "-"); }
+    case "era": return (kind.eras ?? []).includes(v as KindEra);
+    case "lang": return (kind.langs ?? []).includes(v);
+    default: return false;
+  }
+}
+
+/** "Your kind of films" with the muted leans taken out: what every kind reader uses (rule 1781). */
+export function effectiveKind(kind: KindPrefs | null | undefined, off: readonly string[] | null | undefined): KindPrefs | null {
+  if (!kind) return null;
+  const o = new Set((off ?? []).filter((x) => leanKind(x)));
+  if (!o.size) return kind;
+  const genres = (kind.genres ?? []).filter((k) => { const g = [...KIND_GENRES, ...KIND_MORE_GENRES].find((x) => x.key === k)?.genre; return !g || !o.has(`genre:${g}`); });
+  const eras = (kind.eras ?? []).filter((e) => !o.has(`era:${e}`));
+  const langs = (kind.langs ?? []).filter((l) => !o.has(`lang:${l}`));
+  return { ...kind, ...(kind.genres ? { genres } : {}), ...(kind.eras ? { eras } : {}), ...(kind.langs ? { langs } : {}) };
+}
+
+/** Where a new lean goes: "kind" when the person has "Your kind of films" and it takes this one (a genre while
+ *  fewer than GENRE_PICK_MAX are picked, an era of its own, a language), else "boost". Strands and people: boost. */
+export function kindFits(kind: KindPrefs | null | undefined, id: string): boolean {
+  if (!kind || !(kind.genres?.length || kind.eras?.length || kind.subtitles)) return false;
+  const k = leanKind(id), v = id.slice(id.indexOf(":") + 1);
+  if (k === "genre") return !!genreKey(v) && (kind.genres?.length ?? 0) < GENRE_PICK_MAX;
+  if (k === "era") return KIND_ERA_KEYS.has(v);
+  if (k === "lang") return true;
+  return false;
+}
+
+/** A film as a lean reads it (candidate rows and pitch rows carry all of this; a missing field never matches). */
+export type LeanFilm = { genres?: readonly string[] | null; language?: string | null; year?: number | null; directors?: readonly string[] | null;
+  /** The film's strand value for a strand id (the server reads it from the film's labels), or null. */
+  strand?: (id: LeanStrand) => number | null };
+
+/** Whether a film carries this lean. */
+export function leanMatches(id: string, f: LeanFilm): boolean {
+  const k = leanKind(id), v = id.slice(id.indexOf(":") + 1);
+  switch (k) {
+    case "genre": return (f.genres ?? []).includes(v);
+    case "lang": return !!f.language && (v === "zh" ? f.language === "zh" || f.language === "cn" : f.language === v);
+    case "era": { if (f.year == null) return false; const [a, b] = eraRange(v); return f.year >= a && f.year <= b; }
+    case "person": return (f.directors ?? []).includes(v);
+    case "strand": { const s = f.strand?.(v as LeanStrand); return s != null && s >= STRAND_STRONG; }
+  }
+  return false;
+}
+
+/** The leans' prefs: what leanPoints reads. */
+export type LeanPrefs = { learnedOff?: string[]; boost?: string[]; kind?: KindPrefs };
+/** The muted leans that cost rank points (not held by kind), and the boosted ones. */
+export function activeLeans(p: LeanPrefs | null | undefined): { muted: string[]; boost: string[] } {
+  const muted = (p?.learnedOff ?? []).filter((x) => leanKind(x) && !kindCovers(p?.kind, x));
+  const off = new Set(p?.learnedOff ?? []);
+  const boost = (p?.boost ?? []).filter((x) => leanKind(x) && !off.has(x));
+  return { muted, boost };
+}
+
+/** Rank points for a film from the leans (rule 1781): positive lowers it (a muted lean it carries), negative lifts it
+ *  (a boosted one). Never the match %. */
+export function leanPoints(p: LeanPrefs | null | undefined, f: LeanFilm): number {
+  const { muted, boost } = activeLeans(p);
+  if (!muted.length && !boost.length) return 0;
+  const down = Math.min(MUTE_CAP, muted.filter((id) => leanMatches(id, f)).length * MUTE_POINTS);
+  const up = Math.min(BOOST_CAP, boost.filter((id) => leanMatches(id, f)).length * BOOST_POINTS);
+  return down - up;
+}
+
+/** The leans' part of prefsKey, so a mute or a boost rebuilds saved picks: "" with none. */
+export function leansKey(p: LeanPrefs | null | undefined): string {
+  const ids = [...(p?.learnedOff ?? []).filter((x) => leanKind(x)).map((x) => `-${x}`), ...(p?.boost ?? []).filter((x) => leanKind(x)).map((x) => `+${x}`)].sort();
+  if (!ids.length) return "";
+  let h = 5381;
+  for (const ch of ids.join("|")) h = ((h * 33) ^ ch.charCodeAt(0)) >>> 0;
+  return `v${h.toString(36)}`;
+}
+
+/** One chip on the page. `from`: where it came from (data, kind, boost, or a film chip they told us). */
+export type LearnedLean = { id: string; kind: LeanKind | "told"; label: string; from: "data" | "kind" | "boost" | "told" };
+
+// --- The summary line (b69 b): a template, never a model call ---
+
+const STRAND_ADJ: Record<LeanStrand, string> = {
+  emotional_realism: "heartfelt", narrative_complexity: "twisty", slow_burn: "slow-burn", originality: "offbeat", visual_style: "striking",
+  visceral_charge: "intense", spectacle: "big-screen", wonder_imagination: "dreamlike", playful_lightness: "feel-good",
+};
+const STRAND_NOUN: Record<LeanStrand, string> = {
+  emotional_realism: "heartbreak", narrative_complexity: "puzzles", slow_burn: "slow burns", originality: "oddities", visual_style: "style",
+  visceral_charge: "paranoia", spectacle: "spectacle", wonder_imagination: "wonder", playful_lightness: "comfort",
+};
+const GENRE_WORD: Record<string, string> = {
+  Crime: "crime", Thriller: "thrillers", Drama: "dramas", Comedy: "comedies", Horror: "horror", "Science Fiction": "sci-fi", Romance: "romances",
+  Animation: "animation", Documentary: "documentaries", Action: "action", Fantasy: "fantasy", Mystery: "mysteries", Adventure: "adventures",
+  Family: "family films", History: "history films", Music: "music films", War: "war films", Western: "westerns",
+};
+const list = (xs: string[]): string => xs.length <= 1 ? (xs[0] ?? "") : `${xs.slice(0, -1).join(", ")} and ${xs[xs.length - 1]}`;
+
