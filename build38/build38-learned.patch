+/// A solid chip with its kind icon and an × (Pitch's chosen chip; 44 tall, a 44 × target). A told-us chip's name
+/// opens its small menu, on a tap or a long press. A Less of warning carries "Never"; a skip that fades is dashed.
+struct LearnedChip: View {
+    let label: String
+    var icon: Lucide? = nil
+    var never = false
+    var fading = false
+    let onX: () -> Void
+    var onMenu: (() -> Void)? = nil
+    init(label: String, icon: Lucide? = nil, never: Bool = false, fading: Bool = false, onX: @escaping () -> Void, onMenu: (() -> Void)? = nil) {
+        self.label = label; self.icon = icon; self.never = never; self.fading = fading; self.onX = onX; self.onMenu = onMenu
+    }
+    var body: some View {
+        HStack(spacing: Space.s8) {
+            if let icon { Icon(icon, size: 16).foregroundStyle(Theme.accent2) }
+            if let onMenu {
+                Button(action: onMenu) { Text(verbatim: label).font(Typo.meta(.semibold)).foregroundStyle(Theme.ink).frame(minHeight: 44) }
+                    .buttonStyle(.pressable)
+                    .simultaneousGesture(LongPressGesture(minimumDuration: 0.5).onEnded { _ in onMenu() })
+                    .accessibilityHint(Text("Not quite, or stop using it"))
+            } else {
+                Text(verbatim: label).font(Typo.meta(.semibold)).foregroundStyle(Theme.ink)
+            }
+            if never {
+                Text("NEVER").font(Typo.label()).tracking(CapsLabel.track).foregroundStyle(Theme.muted)
+                    .padding(.horizontal, Space.s8).padding(.vertical, 4).overlay(Capsule().stroke(Theme.line2))
+            }
+            Button(action: onX) { Icon(.x, size: 14).foregroundStyle(Theme.muted).frame(width: 44, height: 44) }
+                .buttonStyle(.pressable).padding(.horizontal, -Space.s8)
+                .accessibilityLabel(Text(icon == nil ? "Let \(label) back" : "Stop leaning on \(label)"))
+        }
+        .padding(.leading, icon == nil ? Space.s16 : Space.s12).padding(.trailing, Space.s4)
+        .frame(minHeight: 44)
+        .background(fading ? Color.clear : Theme.selectFill, in: Capsule())
+        .overlay(Capsule().stroke(fading ? Theme.line2 : Theme.selectEdge, style: StrokeStyle(lineWidth: fading ? 1 : Theme.selectEdgeWidth, dash: fading ? [4, 3] : [])))
+        .opacity(fading ? 0.6 : 1)
+    }
+}
