+}
+
+/// Less of's + Add: the content never shown (hard, Things I'd rather avoid) and the kinds shown less (soft, Show less of).
+struct LearnedLessSheet: View {
+    @ObservedObject var prefs: PrefsModel
+    @Environment(\.dismiss) private var dismiss
+    var body: some View {
+        VStack(alignment: .leading, spacing: 0) {
