+            }.filter { hit($0.lean.label) }
+        }
+        return Array(out.filter { !have.contains($0.lean.id) }.prefix(24))
+    }
+
+    var body: some View {
+        VStack(alignment: .leading, spacing: 0) {
+            DrawerHeader(title: "Add to what you're into", sub: "What we've learned") { dismiss() }
+            HStack(spacing: Space.s8) {
+                Icon(.search, size: 18).foregroundStyle(Theme.muted)
