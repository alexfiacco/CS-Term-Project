+                            Button { prefs.setNotMine(prefs.notMine + [k.key]) } label: { HStack(spacing: Space.s8) { Icon(.plus, size: 14); Text(k.label) }.frame(minHeight: 44) }
+                                .buttonStyle(ChipButtonStyle())
+                        }
+                    }
+                }
+                .padding(.bottom, Space.s24)
+            }
+        }
+        .padding(.horizontal, Theme.gutter).padding(.top, DrawerHeader.top).padding(.bottom, Space.s16)
+    }
+}
+
+/// A told-us chip's small menu: Not quite (that film's own chips, rule 1570's correction) or stop using it.
+struct LearnedChipMenu: View {
+    let item: Learned.Item
+    let remove: () -> Void
+    let corrected: () -> Void
+    @Environment(\.dismiss) private var dismiss
+    @State private var options: [RatingChips.Chip] = []
+    @State private var busy = false
+    var body: some View {
+        VStack(alignment: .leading, spacing: 0) {
+            DrawerHeader(title: item.label, sub: "What we've learned") { dismiss() }
+            Text(verbatim: item.line).font(Typo.read(Typo.bodySize)).foregroundStyle(Theme.muted).fixedSize(horizontal: false, vertical: true).padding(.top, Space.s12)
+            Text("Not quite? What did you mean").font(Typo.meta(.medium)).foregroundStyle(Theme.faint).padding(.top, Space.s16).padding(.bottom, Space.s8)
+            FlowLayout(spacing: Space.s8) {
+                ForEach(options) { o in
+                    Button(o.label) { Task { await correct(o.key) } }.buttonStyle(ChipButtonStyle()).frame(minHeight: 44).disabled(busy)
+                }
+            }
+            Button { remove() } label: { HStack(spacing: Space.s8) { Icon(.x, size: 14); Text("Stop using it") }.frame(minHeight: 44) }
+                .buttonStyle(ChipButtonStyle()).padding(.top, Space.s16)
+        }
+        .padding(.horizontal, Theme.gutter).padding(.top, DrawerHeader.top).padding(.bottom, Space.s24)
+        .task {
+            let key = String(item.id.dropFirst(5)), pol = key.hasPrefix("neg:") ? "neg" : "pos"
+            var film: (pos: [RatingChips.Chip], neg: [RatingChips.Chip]) = ([], [])
+            if let slug = item.films?.first?.slug { film = await RatingChips.film(slug: slug) }
+            let l = RatingChips.list(film: pol == "neg" ? film.neg : film.pos, polarity: pol)
+            options = (l.shown + l.more).filter { $0.key != key }
+        }
+    }
+    private func correct(_ to: String) async {
+        haptic(); busy = true
+        let ok = await Learned.post(["correct": String(item.id.dropFirst(5)), "to": to])?.ok == true
+        busy = false
+        if ok { ToastCenter.shared.say(ToastCopy.settingsSaved); corrected() } else { ToastCenter.shared.say("Couldn't save that. Try again.", glyph: .failed) }
+    }
+}
