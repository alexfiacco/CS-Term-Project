diff --git a/app/api/app-diagnostics/route.ts b/app/api/app-diagnostics/route.ts
new file mode 100644
index 00000000..5fd49c83
--- /dev/null
+++ b/app/api/app-diagnostics/route.ts
@@ -0,0 +1,40 @@
+import { NextResponse } from "next/server";
+import { rateLimit } from "@/lib/rate-limit";
+import { recordError, sendOpsAlert } from "@/lib/errlog";
+import { MAX_BODY_BYTES, MAX_REPORTS, cleanReport, countDiagnostic, crashAlert, errlogMessage, firstToday, signatureOf } from "@/lib/app-diagnostics";
+
+export const runtime = "nodejs";
+export const dynamic = "force-dynamic";
+
+/**
+ * POST { reports: [{ kind, appVersion, build, os, device, exception, signal, termination, frames, count }] }
+ * -> { ok, kept }: the iPhone app's MetricKit crash and hang summaries (rule 1760; lib/app-diagnostics.ts).
+ *
+ * No sign-in: a crash can come before there is an account, and a report carries none. Limited per
+ * address (`app-diagnostics`), the body capped at MAX_BODY_BYTES before it is parsed, at most
+ * MAX_REPORTS reports, every field checked against the short system string it should be; anything
+ * else is dropped, never stored. Each kept report goes to the errlog under `ios-<kind>` (a debug
+ * build's sample under `ios-sample`), and a crash alerts the owner once per new signature a day.
+ */
+export async function POST(req: Request): Promise<Response> {
+  const limited = await rateLimit(req, "app-diagnostics");
+  if (limited) return limited;
+  const declared = Number(req.headers.get("content-length") ?? 0);
+  if (declared > MAX_BODY_BYTES) return NextResponse.json({ ok: false }, { status: 413 });
+  const text = await req.text().catch(() => "");
+  if (text.length > MAX_BODY_BYTES) return NextResponse.json({ ok: false }, { status: 413 });
+  let body: { reports?: unknown } = {};
+  try { body = JSON.parse(text) as typeof body; } catch { return NextResponse.json({ ok: false }, { status: 400 }); }
+  if (!Array.isArray(body.reports) || body.reports.length === 0) return NextResponse.json({ ok: false }, { status: 400 });
+  const reports = body.reports.slice(0, MAX_REPORTS).flatMap((r) => { const c = cleanReport(r); return c ? [c] : []; });
+  await Promise.all(reports.map(async (r) => {
+    // Counted and listed like any failure, but never the errlog's "first server error today" alert.
+    await recordError(r.sample ? "ios-sample" : `ios-${r.kind}`, errlogMessage(r), { alert: false });
+    if (!r.sample) await countDiagnostic(r);
+    if (r.kind !== "crash") return;
+    if (!(await firstToday(`${r.sample ? "sample|" : ""}${signatureOf(r)}`))) return;
+    const { headline, detail } = crashAlert(r);
+    await sendOpsAlert(headline, detail);
+  }));
+  return NextResponse.json({ ok: true, kept: reports.length });
+}
