+    private static func machException(_ type: NSNumber?, _ code: NSNumber?) -> String? {
+        guard let type else { return nil }
+        let names: [Int32: String] = [1: "EXC_BAD_ACCESS", 2: "EXC_BAD_INSTRUCTION", 3: "EXC_ARITHMETIC", 5: "EXC_SOFTWARE",
+                                      6: "EXC_BREAKPOINT", 10: "EXC_CRASH", 11: "EXC_RESOURCE", 12: "EXC_GUARD"]
+        let t = type.int32Value
+        let name = names[t] ?? "EXC_\(t)"
+        return code.map { "\(name) (\(t)) code \($0.int64Value)" } ?? "\(name) (\(t))"
+    }
+
+    private static func signalName(_ s: Int32) -> String {
+        let names: [Int32: String] = [4: "SIGILL", 5: "SIGTRAP", 6: "SIGABRT", 7: "SIGEMT", 8: "SIGFPE", 9: "SIGKILL",
+                                      10: "SIGBUS", 11: "SIGSEGV", 12: "SIGSYS", 13: "SIGPIPE", 15: "SIGTERM"]
+        return names[s] ?? String(s)
+    }
+
+    // MARK: Send
+
+    /// No bearer: a report carries no account. One try; a failure is dropped.
+    static func send(_ reports: [[String: Any]]) async {
+        struct OK: Decodable { let ok: Bool?; let kept: Int? }
+        _ = try? await APIClient().post("/api/app-diagnostics", body: ["reports": reports], as: OK.self)
+    }
+
+    #if DEBUG
+    /// Settings' hidden developer row (DEBUG builds only, rule 1760): writes a MetricKit signpost
+    /// through `MXMetricManager.makeLogHandle` and posts a sample crash summary, marked `sample`, so the
+    /// route, the errlog and the owner's alert can be seen end to end without crashing anything.
+    /// Xcode's Debug → Simulate MetricKit Payloads drives `didReceive` itself.
+    static func sendSample() async -> Bool {
+        let log = MXMetricManager.makeLogHandle(category: "montage-dev")
+        mxSignpost(.event, log: log, name: "diagnostics-sample")
+        let sample: [String: Any] = [
+            "kind": "crash", "sample": true,
+            "appVersion": ReportContext.version.isEmpty ? "0.0" : ReportContext.version,
+            "build": ReportContext.build.isEmpty ? "0" : ReportContext.build,
+            "os": await MainActor.run { ReportContext.os }, "device": ReportContext.model,
+            "exception": "EXC_BREAKPOINT (6)", "signal": "SIGTRAP", "termination": "Namespace SIGNAL, Code 0x5",
+            "frames": ["Montage +0x1a2b3c", "Montage +0x1a2000", "SwiftUI +0x4f00c0", "UIKitCore +0x2e3f10", "libdyld.dylib +0x1d3c"],
+            "count": 1,
+        ]
+        struct OK: Decodable { let ok: Bool?; let kept: Int? }
+        let r = try? await APIClient().post("/api/app-diagnostics", body: ["reports": [sample]], as: OK.self)
+        return (r?.kept ?? 0) > 0
+    }
+    #endif
+}
