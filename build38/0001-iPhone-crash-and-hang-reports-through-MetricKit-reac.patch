diff --git a/lib/app-diagnostics.ts b/lib/app-diagnostics.ts
new file mode 100644
index 00000000..c37ef136
--- /dev/null
+++ b/lib/app-diagnostics.ts
@@ -0,0 +1,139 @@
+import { createHash } from "node:crypto";
+import type { SupabaseClient } from "@supabase/supabase-js";
+import { serviceClient } from "./supabase";
+
+/**
+ * iPhone crash and hang reports from Apple's MetricKit (rule 1760), with no third-party SDK and no
+ * account. The app's `CrashReporter` (ios/Montage/Sources/Core/CrashReporter.swift) subscribes to
+ * `MXMetricManager` at launch; iOS hands it the last session's `MXDiagnosticPayload`s on a later
+ * launch, and it posts a compact summary to POST /api/app-diagnostics. This file is the server's
+ * half, pure where it can be: what a report may hold (`cleanReport`), its signature (`signatureOf`)
+ * and the alert's wording (`crashAlert`).
+ *
+ * What a report holds, and nothing else: the app's version and build, the OS version, the device
+ * model ("iPhone16,1"), the diagnostic's kind, the Mach exception type and code, the signal, the
+ * termination reason, an Objective-C exception's class name (never its message, which can quote
+ * data), up to 30 frames of the faulting thread as "binary +offset", and how many times it happened.
+ * No user id, no token, no title, nothing typed. The app's analytics send the raw account id, not a
+ * hashed actor key, so a diagnostic carries no account at all.
+ *
+ * Where it goes: lib/errlog.ts `recordError` under the scope `ios-<kind>` (so it is in /api/health
+ * and the daily ops digest with no new table), a per-kind day counter `ios-diag:<kind>` that the
+ * digest reads, and, for a crash, one `sendOpsAlert` the first time a (version, exception, top
+ * frame) signature is seen in a UTC day.
+ */
+export const DIAG_KINDS = ["crash", "hang", "cpu", "disk", "launch"] as const;
+export type DiagKind = (typeof DIAG_KINDS)[number];
+export const DIAG_COUNT_KIND = "ios-diag:";
+/** The request body's ceiling, in bytes, read before parsing. 30 frames of ~40 characters, ten reports. */
+export const MAX_BODY_BYTES = 32_000;
+export const MAX_REPORTS = 10;
+export const MAX_FRAMES = 30;
+
+export type DiagReport = {
+  kind: DiagKind;
+  appVersion: string;
+  build: string;
+  os: string;
+  device: string;
+  exception: string | null;
+  signal: string | null;
+  termination: string | null;
+  frames: string[];
+  count: number;
+  sample: boolean;
+};
+
+// Each field is a short system string; anything else is dropped, never stored.
+const word = (v: unknown, re: RegExp, max: number): string | null => {
+  if (typeof v !== "string" && typeof v !== "number") return null;
+  const s = String(v).trim().slice(0, max);
+  return s && re.test(s) ? s : null;
+};
+const VERSION = /^[0-9A-Za-z.\-]+$/;
+const OS = /^[0-9A-Za-z .()\-]+$/;
+const DEVICE = /^[A-Za-z]+[0-9]*(,[0-9]+)?( Simulator)?$/;
+// "EXC_BAD_ACCESS (1) KERN_INVALID_ADDRESS", "EXC_CRASH (10)", "NSInvalidArgumentException".
+const EXCEPTION = /^[A-Za-z0-9_ ().,:\-]+$/;
+const SIGNAL = /^(SIG[A-Z]{2,6}|[0-9]{1,3})( \([0-9]{1,3}\))?$/;
+// MetricKit's terminationReason: "Namespace SIGNAL, Code 0xb", "Namespace FRONTBOARD, Code 0x8badf00d".
+const TERMINATION = /^[A-Za-z0-9 _.,:()<>'\-]+$/;
+// "Montage +0x1a2b3c", "libswiftCore.dylib +0x3f0c4", "UIKitCore +123456".
+const FRAME = /^[A-Za-z0-9_.\-]{1,64} \+(0x[0-9a-f]{1,16}|[0-9]{1,20})$/;
+
+/** The termination reason, kept as its safe characters only (other characters become spaces), 120 at most. */
+function systemLine(v: unknown): string | null {
+  if (typeof v !== "string") return null;
+  const s = v.slice(0, 240).replace(/[^A-Za-z0-9 _.,:()<>'\-]+/g, " ").replace(/\s+/g, " ").trim().slice(0, 120);
+  return s && TERMINATION.test(s) ? s : null;
+}
+
+/** A report as the app sent it, kept only if every field is the short system string it should be (pure). */
+export function cleanReport(raw: unknown): DiagReport | null {
+  if (!raw || typeof raw !== "object") return null;
+  const r = raw as Record<string, unknown>;
+  const kind = DIAG_KINDS.find((k) => k === r.kind);
+  const appVersion = word(r.appVersion, VERSION, 20);
+  const build = word(r.build, VERSION, 20);
+  if (!kind || !appVersion || !build) return null;
+  const frames = Array.isArray(r.frames)
+    ? r.frames.slice(0, 60).flatMap((f) => { const s = word(f, FRAME, 90); return s ? [s] : []; }).slice(0, MAX_FRAMES)
+    : [];
+  const count = typeof r.count === "number" && Number.isFinite(r.count) ? Math.min(1000, Math.max(1, Math.round(r.count))) : 1;
+  return {
+    kind, appVersion, build,
+    os: word(r.os, OS, 40) ?? "unknown",
+    device: word(r.device, DEVICE, 32) ?? "unknown",
+    exception: word(r.exception, EXCEPTION, 80),
+    signal: word(r.signal, SIGNAL, 16),
+    termination: systemLine(r.termination),
+    frames, count, sample: r.sample === true,
+  };
+}
+
+/** The frame a crash is named by: the first in the app's own binary, else the first at all (pure). */
+export function topFrame(frames: string[]): string {
+  return frames.find((f) => /^Montage /.test(f)) ?? frames[0] ?? "no frames";
+}
+
+/** (version, exception or signal, top frame): one crash, however many phones hit it (pure). */
+export function signatureOf(r: DiagReport): string {
+  return `${r.appVersion} (${r.build}) | ${r.exception ?? r.signal ?? r.termination ?? r.kind} | ${topFrame(r.frames)}`;
+}
+
+/** The errlog message: one line, the signature first, then where and how often (pure). */
+export function errlogMessage(r: DiagReport): string {
+  const bits = [r.sample ? "[sample]" : "", signatureOf(r), r.signal && r.exception ? r.signal : "", r.termination ?? "",
+    `${r.device}, ${r.os}`, r.count > 1 ? `x${r.count}` : ""].filter(Boolean);
+  return bits.join(" · ").slice(0, 200);
+}
+
+/** A new crash's alert: the headline and the detail sendOpsAlert takes (pure). */
+export function crashAlert(r: DiagReport): { headline: string; detail: string } {
+  const head = r.exception ?? r.signal ?? r.termination ?? "crash";
+  return {
+    headline: `${r.sample ? "sample " : ""}new iPhone crash in ${r.appVersion} (${r.build}): ${head}`,
+    detail: [`at ${topFrame(r.frames)}`, r.signal && r.exception ? r.signal : "", r.termination ?? "", `${r.device}, ${r.os}`,
+      `${r.count} report${r.count === 1 ? "" : "s"}`, `top frames: ${r.frames.slice(0, 5).join(" < ") || "none"}`].filter(Boolean).join("; "),
+  };
+}
+
+const db = (): SupabaseClient => serviceClient() as unknown as SupabaseClient;
+
+/** True the first time this signature is counted today (UTC); false after, or when the counter fails. */
+export async function firstToday(signature: string, d = new Date()): Promise<boolean> {
+  try {
+    const h = createHash("sha256").update(signature).digest("hex").slice(0, 16);
+    const { data, error } = await db().rpc("bump_usage", { p_kind: `ios-crash-sig:${d.toISOString().slice(0, 10)}:${h}`, p_limit: 1_000_000_000 });
+    if (error) return false;
+    const row = (Array.isArray(data) ? data[0] : data) as { current_count?: number } | null;
+    return row?.current_count === 1;
+  } catch {
+    return false;
+  }
+}
+
+/** Adds a report's count to today's `ios-diag:<kind>` counter, which the daily digest reads. */
+export async function countDiagnostic(r: DiagReport): Promise<void> {
+  try { await db().rpc("add_usage", { p_kind: `${DIAG_COUNT_KIND}${r.kind}`, p_n: r.count }); } catch { /* counting never fails a request */ }
+}
