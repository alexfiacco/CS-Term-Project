diff --git a/ios/Montage/Sources/Core/CrashReporter.swift b/ios/Montage/Sources/Core/CrashReporter.swift
new file mode 100644
index 00000000..b68b5f54
--- /dev/null
+++ b/ios/Montage/Sources/Core/CrashReporter.swift
@@ -0,0 +1,159 @@
+import Foundation
+import MetricKit
+import os
+
+/// Crash and hang reports from Apple's MetricKit (rule 1760), with no third-party SDK and no account.
+/// Subscribed at launch (`AppDelegate`); iOS delivers the last sessions' `MXDiagnosticPayload`s on a
+/// later launch (about once a day), and each delivery goes up as one compact summary to
+/// POST /api/app-diagnostics, which keeps it in the server's error log and alerts the owner once per
+/// new crash a day.
+///
+/// What leaves the phone, and nothing else: the app's version and build, the OS version, the device
+/// model, the diagnostic's kind, the exception type and code, the signal, the termination reason, an
+/// Objective-C exception's class name (never its message), up to 30 frames of the faulting thread as
+/// "binary +offset", and how many times that same report came. No token, no account id, no title,
+/// nothing typed. Nothing is written to disk (rule 26): a send that fails is dropped, and MetricKit
+/// keeps its own copy in `pastDiagnosticPayloads` for Xcode.
+final class CrashReporter: NSObject, MXMetricManagerSubscriber, @unchecked Sendable {
+    static let shared = CrashReporter()
+    private static let maxFrames = 30
+    private static let maxReports = 10
+
+    /// Adds the subscriber once; called from `application(_:didFinishLaunchingWithOptions:)`.
+    func start() {
+        MXMetricManager.shared.add(self)
+    }
+
+    // MARK: MXMetricManagerSubscriber
+
+    func didReceive(_ payloads: [MXDiagnosticPayload]) {
+        let reports = Self.reports(from: payloads)
+        guard !reports.isEmpty else { return }
+        Task.detached(priority: .utility) { await Self.send(reports) }
+    }
+
+    // Daily metrics (MXMetricPayload) are not sent: only diagnostics are wanted.
+    func didReceive(_ payloads: [MXMetricPayload]) {}
+
+    // MARK: Summary
+
+    /// One summary per (kind, version and build, exception, top frame) in the delivery, with its count.
+    static func reports(from payloads: [MXDiagnosticPayload]) -> [[String: Any]] {
+        var out: [String: [String: Any]] = [:]
+        var order: [String] = []
+        func add(_ kind: String, _ d: MXDiagnostic, exception: String?, signal: String?, termination: String?, tree: MXCallStackTree?) {
+            let frames = tree.map { Self.frames($0.jsonRepresentation()) } ?? []
+            let key = [kind, d.applicationVersion, d.metaData.applicationBuildVersion, exception ?? "", signal ?? "", frames.first(where: { $0.hasPrefix("Montage ") }) ?? frames.first ?? ""].joined(separator: "|")
+            if var seen = out[key] {
+                seen["count"] = (seen["count"] as? Int ?? 1) + 1
+                out[key] = seen
+                return
+            }
+            var r: [String: Any] = [
+                "kind": kind,
+                "appVersion": d.applicationVersion,
+                "build": d.metaData.applicationBuildVersion,
+                "os": d.metaData.osVersion,
+                "device": d.metaData.deviceType,
+                "frames": frames,
+                "count": 1,
+            ]
+            if let exception { r["exception"] = exception }
+            if let signal { r["signal"] = signal }
+            // A system string ("Namespace SIGNAL, Code 0xb"); the server keeps its first 120 characters.
+            if let termination { r["termination"] = String(termination.prefix(120)) }
+            out[key] = r
+            order.append(key)
+        }
+        for p in payloads {
+            for c in p.crashDiagnostics ?? [] {
+                var exception = Self.machException(c.exceptionType, c.exceptionCode)
+                // The class only ("NSInvalidArgumentException"): its composed message can quote data.
+                if let name = c.exceptionReason?.exceptionName, !name.isEmpty { exception = name }
+                add("crash", c, exception: exception, signal: c.signal.map { Self.signalName($0.int32Value) },
+                    termination: c.terminationReason, tree: c.callStackTree)
+            }
+            for h in p.hangDiagnostics ?? [] {
+                let secs = Int(h.hangDuration.converted(to: .seconds).value.rounded())
+                add("hang", h, exception: "hang \(secs)s", signal: nil, termination: nil, tree: h.callStackTree)
+            }
+            for c in p.cpuExceptionDiagnostics ?? [] {
+                let secs = Int(c.totalCPUTime.converted(to: .seconds).value.rounded())
+                add("cpu", c, exception: "cpu \(secs)s", signal: nil, termination: nil, tree: c.callStackTree)
+            }
+            for w in p.diskWriteExceptionDiagnostics ?? [] {
+                let mb = Int(w.totalWritesCaused.converted(to: .megabytes).value.rounded())
+                add("disk", w, exception: "disk writes \(mb) MB", signal: nil, termination: nil, tree: w.callStackTree)
+            }
+            for l in p.appLaunchDiagnostics ?? [] {
+                let secs = Int(l.launchDuration.converted(to: .seconds).value.rounded())
+                add("launch", l, exception: "launch \(secs)s", signal: nil, termination: nil, tree: l.callStackTree)
+            }
+        }
+        return order.prefix(maxReports).compactMap { out[$0] }
+    }
+
+    /// The faulting thread's frames from `MXCallStackTree.jsonRepresentation()`, innermost first:
+    /// the attributed thread (else the first), each root frame and its first sub-frame chain, as
+    /// "binary +0xoffset". MetricKit does not symbolicate; the offsets match the build's dSYM.
+    static func frames(_ json: Data) -> [String] {
+        guard let root = try? JSONSerialization.jsonObject(with: json) as? [String: Any],
+              let stacks = root["callStacks"] as? [[String: Any]], !stacks.isEmpty else { return [] }
+        let stack = stacks.first(where: { ($0["threadAttributed"] as? Bool) == true }) ?? stacks[0]
+        var out: [String] = []
+        var level = stack["callStackRootFrames"] as? [[String: Any]] ?? []
+        while let f = level.first, out.count < maxFrames {
+            let binary = (f["binaryName"] as? String) ?? "?"
+            let offset = (f["offsetIntoBinaryTextSegment"] as? NSNumber)?.uint64Value ?? 0
+            out.append("\(binary) +0x\(String(offset, radix: 16))")
+            level = f["subFrames"] as? [[String: Any]] ?? []
+        }
+        return out
+    }
