diff --git a/lib/motion.ts b/lib/motion.ts
new file mode 100644
index 00000000..44da8789
--- /dev/null
+++ b/lib/motion.ts
@@ -0,0 +1,83 @@
+/**
+ * Build 38's motion (owner-approved 2026-11-12, CS-Term-Project mockups/journeys/motion/b66-motion.html,
+ * clips 1, 3, 5 and 6; rules 1730-1733). One curve, ease-out cubic-bezier(.2,.7,.2,1); transforms and
+ * opacity only; every piece has its Reduce Motion form. The iPhone's twin is Design/Motion.swift.
+ */
+
+/** The one curve. */
+export const MOTION_EASE = "cubic-bezier(.2,.7,.2,1)";
+
+/** "Choose one from these" (clip 1): the timings of a full run and of a reroll's shorter one (ms). */
+export type ChooseTiming = {
+  /** One card's deal (full) or the fan's fade in (reroll), and the gap between dealt cards. */
+  deal: number; dealGap: number;
+  /** The riffle: into one stack, then out into the new order. */
+  gather: number; fan: number;
+  /** The light's steps, each longer than the last; the last lands on the chosen film. */
+  gaps: number[];
+  /** The chosen poster's lift, its title, the hold on the result and the layer's fade off it. */
+  lift: number; title: number; hold: number; out: number;
+};
+/** About 1.8s to the landing with seven films: deal 0.6, riffle 0.4, light 0.5, lift 0.42. */
+export const CHOOSE_FULL: ChooseTiming = { deal: 360, dealGap: 40, gather: 180, fan: 220, gaps: [30, 35, 40, 50, 60, 75, 95, 120], lift: 420, title: 380, hold: 450, out: 260 };
+/** A reroll: no deal, a quicker riffle and light, about 0.9s to the landing. */
+export const CHOOSE_SHORT: ChooseTiming = { deal: 100, dealGap: 0, gather: 140, fan: 180, gaps: [45, 70, 110], lift: 300, title: 300, hold: 500, out: 220 };
+/** The most cards in the fan (Pitch's shortlist is seven). */
+export const CHOOSE_MAX = 7;
+
+/** Where a slot of an n-card fan sits: spread wider with fewer cards, fanned by 4.5 degrees a slot. */
+export function fanSlot(slot: number, n: number): { x: number; y: number; r: number } {
+  const c = (n - 1) / 2;
+  const step = n <= 3 ? 70 : n <= 5 ? 52 : 40;
+  return { x: (slot - c) * step, y: Math.abs(slot - c) * 6, r: (slot - c) * 4.5 };
+}
+
+/** The riffle's new order: card i goes to slot order[i]. Fixed for a count (no randomness: the
+ *  choice is already made, this only moves the cards), and never the identity for two or more. */
+export function chooseShuffleOrder(n: number, winner: number): number[] {
+  if (n < 2) return [0];
+  let seed = (n * 7919 + winner * 104729) >>> 0;
+  const rnd = () => { seed = (seed * 1664525 + 1013904223) >>> 0; return seed / 4294967296; };
+  const o = Array.from({ length: n }, (_, i) => i);
+  for (let i = n - 1; i > 0; i--) { const j = Math.floor(rnd() * (i + 1)); [o[i], o[j]] = [o[j], o[i]]; }
+  if (o.every((v, i) => v === i)) o.push(o.shift()!);
+  return o;
+}
+
+/** The light's path across an n-card fan: `steps` slots, bouncing end to end, ending on `target`. */
+export function choosePath(n: number, target: number, steps: number): number[] {
+  if (n < 2) return [0];
+  const seq: number[] = [];
+  let s = 0, d = 1;
+  for (let k = 0; k < steps * 4 + n * 4; k++) { seq.push(s); if (s + d < 0 || s + d >= n) d = -d; s += d; }
+  for (let end = steps - 1; end < seq.length; end++) if (seq[end] === target) return seq.slice(end - steps + 1, end + 1);
+  return [...seq.slice(0, steps - 1), target];
+}
+
+/** Which cards the fan shows: at most CHOOSE_MAX, always including the chosen one; and its place there. */
+export function chooseWindow<T>(all: T[], chosen: number): { cards: T[]; winner: number } {
+  if (all.length <= CHOOSE_MAX) return { cards: all, winner: chosen };
+  const from = Math.max(0, Math.min(chosen - Math.floor(CHOOSE_MAX / 2), all.length - CHOOSE_MAX));
+  return { cards: all.slice(from, from + CHOOSE_MAX), winner: chosen - from };
+}
+
+/** The reveal (clip 3): each letter of the name 460ms, 85ms apart, over a 3.6s push-in to 1.075. */
+export const REVEAL_LETTER_MS = 460;
+export const REVEAL_LETTER_GAP_MS = 85;
+export const REVEAL_PUSH_MS = 3600;
+export const REVEAL_PUSH_SCALE = 1.075;
+/** Reduce Motion: the wall holds still and the name fades in whole. */
+export const REVEAL_FADE_MS = 400;
+
+/** Picks' Seen (clip 5): the card leaves left in 320ms; the next rises into place in 350ms, 50ms later. */
+export const SEEN_OUT_MS = 320;
+export const SEEN_IN_MS = 350;
+export const SEEN_IN_DELAY_MS = 50;
+/** Reduce Motion: no slide, a 200ms crossfade to the next card. */
+export const SEEN_FADE_MS = 200;
+
+/** The Blend (clip 6): the faces slide together from 150px out in 560ms, the % counts in 700ms, the
+ *  italic band rises 6px and fades in over 420ms once the number lands. */
+export const BLEND_FACES_MS = 560;
+export const BLEND_COUNT_MS = 700;
+export const BLEND_BAND_MS = 420;
