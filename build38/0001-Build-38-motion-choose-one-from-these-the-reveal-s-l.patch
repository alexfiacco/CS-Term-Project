+/// One card of the "Choose one from these" fan.
+struct ShuffleCard: Identifiable {
+    let slug: String
+    let title: String
+    let posterUrl: String?
+    var id: String { slug }
+}
+
+/// "Choose one from these" (owner-approved 2026-11-12, b66-motion.html clip 1; rule 1730; the web's
+/// ChooseShuffle.tsx): the shortlist's posters deal into a fan, riffle once, a light steps across them,
+/// slowing, and stops on the chosen film, which lifts forward with its match % and title; then the layer
+/// fades off the result under it. The choice is made before this shows (`winner`): it only reveals it.
+/// 1 to 7 cards (one: straight to the lift); `short` for a reroll (about 0.9s). A tap skips to the result.
+/// A selection tick on each light step, one success on the landing. Reduce Motion: the fan fades in, then
+/// the choice crossfades in place, one success.
+struct ChooseShuffleView: View {
+    let cards: [ShuffleCard]
+    let winner: Int
+    var short = false
+    /// The winner's match as shown ("94%"), or nil.
+    let pct: String?
+    var meta: String? = nil
+    /// The layer covers the screen: the result can go in under it.
+    var onCovered: () -> Void = {}
+    let onDone: () -> Void
+
+    @Environment(\.accessibilityReduceMotion) private var reduceMotion
+    private struct Card { var x: CGFloat = 0; var y: CGFloat = 0; var r: Double = 0; var s: CGFloat = 1; var o: Double = 0; var dim: Double = 0; var z: Double = 0 }
+    @State private var st: [Card] = []
+    @State private var ground: Double = 0
+    @State private var pickShown = false
+    @State private var layer: Double = 1
+    @State private var skipped = false
+    @State private var covered = false
+
+    private var n: Int { cards.count }
+    private var w: Int { min(max(winner, 0), max(n - 1, 0)) }
+    private var order: [Int] { Motion.shuffleOrder(n, winner: w) }
+
+    var body: some View {
+        let f = cards.isEmpty ? nil : cards[w]
+        GeometryReader { g in
+            ZStack {
+                Theme.bg.opacity(ground).ignoresSafeArea()
+                ForEach(Array(cards.enumerated()), id: \.element.id) { i, c in
+                    let s = i < st.count ? st[i] : Card()
+                    Poster(url: c.posterUrl, width: 92)
+                        .overlay(Theme.bg.opacity(s.dim).clipShape(RoundedRectangle(cornerRadius: Theme.radiusSm)))
+                        .shMenu()
+                        .scaleEffect(s.s)
+                        .rotationEffect(.degrees(s.r))
+                        .offset(x: s.x, y: s.y)
+                        .opacity(s.o)
+                        .zIndex(s.z)
+                        .position(x: g.size.width / 2, y: g.size.height * 0.44)
+                }
+                if let f {
+                    VStack(spacing: Space.s8) {
+                        if let pct {
+                            HStack(alignment: .firstTextBaseline, spacing: 8) {
+                                Text(pct).font(Typo.title(.medium)).monospacedDigit().foregroundStyle(Theme.accent2)
+                                Text("match").font(Typo.label()).tracking(CapsLabel.track).textCase(.uppercase).foregroundStyle(Theme.faint)
+                            }
+                        }
+                        Text(f.title).font(Typo.title()).foregroundStyle(Theme.ink).multilineTextAlignment(.center).lineLimit(2)
+                        if let meta { Text(meta).font(Typo.meta()).foregroundStyle(Theme.muted) }
+                    }
+                    .padding(.horizontal, Theme.gutter)
+                    .frame(width: g.size.width)
+                    .position(x: g.size.width / 2, y: g.size.height * 0.44 + 150 + 40)
+                    .opacity(pickShown ? 1 : 0)
+                    .offset(y: pickShown || reduceMotion ? 0 : 10)
+                }
+            }
+        }
+        .opacity(layer)
+        .contentShape(Rectangle())
+        .onTapGesture { skipped = true }
+        .accessibilityElement(children: .ignore)
+        .accessibilityLabel(f.map { "Chosen: \($0.title)" } ?? "")
+        .accessibilityAddTraits(.updatesFrequently)
+        .task { await run() }
+    }
+
+    private func at(_ slot: Int) -> Card {
+        let p = Motion.fanSlot(slot, n)
+        return Card(x: p.x, y: p.y, r: p.r, s: 1, o: 1, dim: 0, z: 10 - abs(Double(slot) - Double(n - 1) / 2))
+    }
+    private func sleep(_ s: Double) async { try? await Task.sleep(for: .seconds(s)) }
+    private func cover() { if !covered { covered = true; onCovered() } }
+
+    /// The resting state: the winner forward, the rest sunk back, the title in.
+    private func land() {
+        var t = Transaction(); t.disablesAnimations = true
+        withTransaction(t) {
+            ground = 1
+            for i in st.indices {
+                if i == w { st[i] = Card(x: 0, y: -40, r: 0, s: 1.7, o: 1, dim: 0, z: 40) }
+                else { var c = at(order[i]); c.y += 26; c.s = 0.94; c.o = reduceMotion ? 0.12 : 0.14; c.z = 1; st[i] = c }
+            }
+            pickShown = true
+        }
+        cover()
+    }
+
+    private func finish(_ T: Motion.ChooseTiming) async {
+        if !skipped { await sleep(T.hold) }
+        withAnimation(.linear(duration: reduceMotion ? 0.2 : T.out)) { layer = 0 }
+        await sleep(reduceMotion ? 0.2 : T.out)
+        onDone()
+    }
+
+    private func run() async {
+        guard n > 0 else { onDone(); return }
+        let T = short ? Motion.chooseShort : Motion.chooseFull
+        let tick = UISelectionFeedbackGenerator()
+        let done = UINotificationFeedbackGenerator()
+        tick.prepare(); done.prepare()
+        st = (0..<n).map { i in var c = at(i); c.o = 0; return c }
+        if reduceMotion {
+            // No deal, riffle or lift: the fan fades in (200ms), then the choice crossfades in place (250ms).
+            withAnimation(.linear(duration: 0.2)) { ground = 1; for i in st.indices { st[i].o = 1 } }
+            await sleep(0.2); cover()
+            await sleep(0.45)
+            var t = Transaction(); t.disablesAnimations = true
+            withTransaction(t) { st[w] = Card(x: 0, y: -40, r: 0, s: 1.7, o: 0, dim: 0, z: 40) }
+            withAnimation(.linear(duration: 0.25)) {
+                for i in st.indices where i != w { st[i].o = 0.12 }
+                st[w].o = 1; pickShown = true
+            }
+            await sleep(0.25)
+            done.notificationOccurred(.success)
+            await finish(T)
+            return
+        }
+        // The ground covers the screen first, so the result can go in under it unseen.
+        withAnimation(.linear(duration: 0.15)) { ground = 1 }
+        Task { await sleep(0.15); cover() }
+        if n > 1 {
+            if !short {
+                // The deal: from below the screen into the fan, one after another.
+                for i in st.indices {
+                    var t = Transaction(); t.disablesAnimations = true
+                    withTransaction(t) { st[i].y = 520; st[i].r = (Double(i) - Double(n - 1) / 2) * 12; st[i].o = 0 }
+                }
+                for i in st.indices {
+                    withAnimation(Motion.ease(T.deal).delay(Double(i) * T.dealGap)) { st[i] = at(i) }
+                }
+                await sleep(T.deal + T.dealGap * Double(n - 1))
+            } else {
+                withAnimation(.linear(duration: T.deal)) { for i in st.indices { st[i].o = 1 } }
+                await sleep(T.deal)
+            }
+            if skipped { land(); done.notificationOccurred(.success); await finish(T); return }
+            // One riffle: into a single stack and out again in the new order.
+            withAnimation(.timingCurve(0.4, 0, 0.2, 1, duration: T.gather)) {
+                for i in st.indices { st[i].x = 0; st[i].y = 0; st[i].r = (Double(i) - Double(n - 1) / 2) * 1.5 }
+            }
+            await sleep(T.gather)
+            withAnimation(Motion.ease(T.fan)) { for i in st.indices { st[i] = at(order[i]) } }
+            await sleep(T.fan)
+            if skipped { land(); done.notificationOccurred(.success); await finish(T); return }
+            // The light: across the fan, each step longer, stopping on the chosen film; a tick each step.
+            var bySlot = Array(repeating: 0, count: n)
+            for i in 0..<n { bySlot[order[i]] = i }
+            withAnimation(Motion.ease(0.12)) { for i in st.indices { st[i].dim = 0.5 } }
+            var lit = -1
+            for (k, s) in Motion.path(n, target: order[w], steps: T.gaps.count).enumerated() {
+                if lit >= 0, lit != s { let i = bySlot[lit]; withAnimation(Motion.ease(0.16)) { st[i].y = at(lit).y; st[i].dim = 0.5 } }
+                let i = bySlot[s]
+                withAnimation(Motion.ease(0.14)) { st[i].y = at(s).y - 14; st[i].dim = 0 }
+                lit = s
+                tick.selectionChanged()
+                await sleep(T.gaps[k])
+                if skipped { break }
+            }
+            if skipped { land(); done.notificationOccurred(.success); await finish(T); return }
+            // The landing: the chosen film lifts forward; the rest sink back.
+            withAnimation(Motion.ease(T.lift)) {
+                for i in st.indices where i != w { var c = at(order[i]); c.y += 26; c.s = 0.94; c.o = 0.14; c.z = st[i].z; st[i] = c }
+                st[w] = Card(x: 0, y: -40, r: 0, s: 1.7, o: 1, dim: 0, z: 40)
+            }
+        } else {
+            // One film: straight to the lift.
+            var t = Transaction(); t.disablesAnimations = true
+            withTransaction(t) { st[0] = Card(x: 0, y: 60, r: 0, s: 1, o: 0, dim: 0, z: 40) }
+            withAnimation(Motion.ease(T.lift)) { st[0] = Card(x: 0, y: -40, r: 0, s: 1.7, o: 1, dim: 0, z: 40) }
+        }
+        withAnimation(Motion.ease(T.title).delay(T.lift * 0.35)) { pickShown = true }
+        await sleep(T.lift)
+        done.notificationOccurred(.success)
+        await sleep(max(0, T.lift * 0.35 + T.title - T.lift))
+        if skipped { land() }
+        await finish(T)
+    }
+}
