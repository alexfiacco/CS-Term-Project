+
+/// Build 38's motion (owner-approved 2026-11-12, CS-Term-Project mockups/journeys/motion/b66-motion.html,
+/// clips 1, 3, 5 and 6; rules 1730-1733; the web's lib/motion.ts). One curve, ease-out
+/// cubic-bezier(.2,.7,.2,1); transforms and opacity only; every piece has its Reduce Motion form.
+enum Motion {
+    /// The one curve, for a duration in seconds.
+    static func ease(_ d: Double) -> Animation { .timingCurve(0.2, 0.7, 0.2, 1, duration: d) }
+
+    // "Choose one from these" (clip 1): seconds, as the web's CHOOSE_FULL and CHOOSE_SHORT.
+    struct ChooseTiming {
+        let deal: Double, dealGap: Double, gather: Double, fan: Double
+        let gaps: [Double]
+        let lift: Double, title: Double, hold: Double, out: Double
+    }
+    static let chooseFull = ChooseTiming(deal: 0.36, dealGap: 0.04, gather: 0.18, fan: 0.22, gaps: [0.03, 0.035, 0.04, 0.05, 0.06, 0.075, 0.095, 0.12],
+                                         lift: 0.42, title: 0.38, hold: 0.45, out: 0.26)
+    static let chooseShort = ChooseTiming(deal: 0.1, dealGap: 0, gather: 0.14, fan: 0.18, gaps: [0.045, 0.07, 0.11],
+                                          lift: 0.3, title: 0.3, hold: 0.5, out: 0.22)
+    static let chooseMax = 7
+
+    /// Where a slot of an n-card fan sits (the web's `fanSlot`).
+    static func fanSlot(_ slot: Int, _ n: Int) -> (x: CGFloat, y: CGFloat, r: Double) {
+        let c = Double(n - 1) / 2
+        let step: Double = n <= 3 ? 70 : n <= 5 ? 52 : 40
+        let d = Double(slot) - c
+        return (CGFloat(d * step), CGFloat(abs(d) * 6), d * 4.5)
+    }
+
+    /// The riffle's new order, fixed for a count (the web's `chooseShuffleOrder`).
+    static func shuffleOrder(_ n: Int, winner: Int) -> [Int] {
+        guard n > 1 else { return [0] }
+        var seed = UInt32(truncatingIfNeeded: n &* 7919 &+ winner &* 104729)
+        func rnd() -> Double { seed = seed &* 1664525 &+ 1013904223; return Double(seed) / 4294967296 }
+        var o = Array(0..<n)
+        for i in stride(from: n - 1, to: 0, by: -1) { let j = Int(rnd() * Double(i + 1)); o.swapAt(i, j) }
+        if o == Array(0..<n) { o.append(o.removeFirst()) }
+        return o
+    }
+
+    /// The light's path across the fan, bouncing end to end and ending on `target` (the web's `choosePath`).
+    static func path(_ n: Int, target: Int, steps: Int) -> [Int] {
+        guard n > 1 else { return [0] }
+        var seq: [Int] = []
+        var s = 0, d = 1
+        for _ in 0..<(steps * 4 + n * 4) { seq.append(s); if s + d < 0 || s + d >= n { d = -d }; s += d }
+        for end in (steps - 1)..<seq.count where seq[end] == target { return Array(seq[(end - steps + 1)...end]) }
+        return Array(seq.prefix(steps - 1)) + [target]
+    }
+
+    /// At most `chooseMax` cards, always with the chosen one, and its place among them (the web's `chooseWindow`).
+    static func window<T>(_ all: [T], chosen: Int) -> (cards: [T], winner: Int) {
+        guard all.count > chooseMax else { return (all, chosen) }
+        let from = max(0, min(chosen - chooseMax / 2, all.count - chooseMax))
+        return (Array(all[from..<(from + chooseMax)]), chosen - from)
+    }
+
+    // The reveal (clip 3).
+    static let revealLetter: Double = 0.46
+    static let revealLetterGap: Double = 0.085
+    static let revealPush: Double = 3.6
+    static let revealPushScale: CGFloat = 1.075
+    static let revealFade: Double = 0.4
+
+    // Picks' Seen (clip 5).
+    static let seenOut: Double = 0.32
+    static let seenIn: Double = 0.35
+    static let seenInDelay: Double = 0.05
+    static let seenFade: Double = 0.2
+
+    // The Blend (clip 6).
+    static let blendFaces: Double = 0.56
+    static let blendCount: Double = 0.7
+    static let blendBand: Double = 0.42
+}
