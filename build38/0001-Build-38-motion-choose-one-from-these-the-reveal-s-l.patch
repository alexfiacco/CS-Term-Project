+"use client";
+
+import { useEffect, useRef } from "react";
+import { createPortal } from "react-dom";
+import { tmdbSized } from "@/lib/image-size";
+import { canVibrate } from "@/lib/haptic";
+import { CHOOSE_FULL, CHOOSE_SHORT, MOTION_EASE, choosePath, chooseShuffleOrder, fanSlot, type ChooseTiming } from "@/lib/motion";
+
+/** One card of the fan: the poster and its title (the title is read only for the winner). */
+export type ShuffleCard = { slug: string; title: string; posterUrl: string | null };
+
+const reducedMotion = () => { try { return window.matchMedia("(prefers-reduced-motion: reduce)").matches; } catch { return false; } };
+/** A light tick per step and one longer buzz on the landing, where the phone has a vibration motor
+ *  (Android). iPhone Safari plays haptics only inside a touch's own events, never from a timer. */
+const buzz = (ms: number) => { try { if (canVibrate()) navigator.vibrate(ms); } catch { /* not supported */ } };
+
+/**
+ * "Choose one from these" (owner-approved 2026-11-12, CS-Term-Project mockups/journeys/motion/b66-motion.html
+ * clip 1; rule 1730). The shortlist's posters deal into a fan, riffle once, a light steps across them,
+ * slowing, and stops on the chosen film, which lifts forward with its match % and title; then the layer
+ * fades off the result under it. The choice is made before this mounts (`winner`): the motion only
+ * reveals it. 1 to 7 cards; with one, straight to the lift. `short` (a reroll): no deal, a quicker riffle
+ * and light, about 0.9s. A tap anywhere skips to the result. Reduce Motion: the fan fades in, then the
+ * choice crossfades in place. Transforms and opacity only, one curve (`MOTION_EASE`).
+ */
+export function ChooseShuffle({ cards, winner, short = false, pct, meta, onCovered, onDone }: {
+  cards: ShuffleCard[];
+  /** The index in `cards` of the film the existing logic chose. */
+  winner: number;
+  short?: boolean;
+  /** The winner's match, shown, or null with no match to show. */
+  pct: number | null;
+  /** The line under the title ("2003 · Park Chan-wook"), or null. */
+  meta?: string | null;
+  /** The layer now covers the screen: the result can be put under it, unseen until the layer fades off. */
+  onCovered?: () => void;
+  onDone: () => void;
+}) {
+  const layer = useRef<HTMLDivElement>(null);
+  const skip = useRef<(() => void) | null>(null);
+  const doneRef = useRef(onDone);
+  doneRef.current = onDone;
+  const coveredRef = useRef(onCovered);
+  coveredRef.current = onCovered;
+
+  useEffect(() => {
+    const root = layer.current;
+    if (!root) return;
+    const els = [...root.querySelectorAll<HTMLElement>(".chs-card")];
+    const bg = root.querySelector<HTMLElement>(".chs-bg")!;
+    const pick = root.querySelector<HTMLElement>(".chs-pick")!;
+    const n = els.length;
+    const w = Math.min(Math.max(winner, 0), n - 1);
+    const rm = reducedMotion();
+    const T: ChooseTiming = short ? CHOOSE_SHORT : CHOOSE_FULL;
+    let live = true;
+    let skipped = false;
+    let finish: () => void = () => {};
+    const skipWait = new Promise<void>((r) => { finish = r; });
+    const wait = (ms: number) => Promise.race([new Promise<void>((r) => window.setTimeout(r, ms)), skipWait]);
+    const anim = (el: Element, kf: Keyframe[], o: KeyframeAnimationOptions) => el.animate(kf, { easing: MOTION_EASE, fill: "forwards", ...o });
+    // A card is dimmed by its own dark veil (opacity), never a filter.
+    const dim = (el: HTMLElement, to: number, ms = 140) => { const v = el.querySelector(".chs-dim"); if (v) anim(v, [{ opacity: Number(getComputedStyle(v).opacity) }, { opacity: to }], { duration: ms }); };
+    let coveredDone = false;
+    const covered = () => { if (!coveredDone) { coveredDone = true; coveredRef.current?.(); } };
+    const at = (slot: number, extra = "") => { const p = fanSlot(slot, n); return `translate(${p.x}px, ${p.y}px) rotate(${p.r}deg)${extra ? ` ${extra}` : ""}`; };
+    const LIFT = "translate(0px, -40px) rotate(0deg) scale(1.7)";
+    const order = chooseShuffleOrder(n, w);
+    // The resting state of the result: the winner forward, the rest sunk back, the title in.
+    const landed = () => {
+      root.getAnimations({ subtree: true }).forEach((a) => a.cancel());
+      covered();
+      bg.style.opacity = "1";
+      els.forEach((el) => { const v = el.querySelector<HTMLElement>(".chs-dim"); if (v) v.style.opacity = "0"; });
+      els.forEach((el, i) => {
+        el.style.zIndex = i === w ? "40" : "1";
+        el.style.transform = i === w ? LIFT : at(order[i], "translateY(26px) scale(.94)");
+        el.style.opacity = i === w ? "1" : rm ? ".12" : ".14";
+      });
+      pick.style.opacity = "1"; pick.style.transform = "none";
+    };
+    const out = async () => {
+      await wait(T.hold);
+      if (!live) return;
+      await anim(root, [{ opacity: 1 }, { opacity: 0 }], { duration: rm ? 200 : T.out, easing: "linear" }).finished.catch(() => {});
+      if (live) doneRef.current();
+    };
+    skip.current = () => {
+      if (skipped) return;
+      skipped = true;
+      finish();
+    };
+    void (async () => {
+      els.forEach((el, i) => { el.style.zIndex = String(10 - Math.abs(i - (n - 1) / 2)); });
+      if (rm) {
+        // Reduce Motion: no deal, riffle or lift. The fan fades in (200ms), then the choice crossfades in place (250ms).
+        els.forEach((el, i) => { el.style.transform = at(i); });
+        anim(bg, [{ opacity: 0 }, { opacity: 1 }], { duration: 200, easing: "linear" });
+        els.forEach((el) => anim(el, [{ opacity: 0 }, { opacity: 1 }], { duration: 200, easing: "linear" }));
+        await wait(200);
+        covered();
+        await wait(450);
+        if (!live) return;
+        els.forEach((el, i) => { el.getAnimations().forEach((a) => a.cancel()); el.style.opacity = "1"; if (i === w) el.style.zIndex = "40"; });
+        const big = els[w];
+        big.style.transform = LIFT;
+        els.forEach((el, i) => { if (i !== w) anim(el, [{ opacity: 1 }, { opacity: 0.12 }], { duration: 250, easing: "linear" }); });
+        anim(big, [{ opacity: 0 }, { opacity: 1 }], { duration: 250, easing: "linear" });
+        anim(pick, [{ opacity: 0 }, { opacity: 1 }], { duration: 250, easing: "linear" });
+        await wait(250);
+        if (!live) return;
+        landed();
+        buzz(20);
+        await out();
+        return;
+      }
+      // The ground covers the screen first (150ms), so the result can go in under it unseen.
+      anim(bg, [{ opacity: 0 }, { opacity: 1 }], { duration: 150, easing: "linear" });
+      window.setTimeout(() => { if (live) covered(); }, 150);
+      if (n > 1) {
+        if (!short) {
+          // The deal: from below the screen into a fan, one after another.
+          els.forEach((el, i) => anim(el, [{ transform: `translate(0px, 520px) rotate(${(i - (n - 1) / 2) * 12}deg)`, opacity: 0 }, { opacity: 1, offset: 0.3 }, { transform: at(i), opacity: 1 }],
+            { duration: T.deal, delay: i * T.dealGap }));
+          await wait(T.deal + T.dealGap * (n - 1));
+        } else {
+          els.forEach((el, i) => anim(el, [{ transform: at(i), opacity: 0 }, { transform: at(i), opacity: 1 }], { duration: T.deal, easing: "linear" }));
+          await wait(T.deal);
+        }
+        if (skipped || !live) { if (live) { landed(); buzz(20); await out(); } return; }
+        // One riffle: into a single stack (one movement, its own curve) and out again in a new order.
+        els.forEach((el, i) => anim(el, [{ transform: at(i), opacity: 1 }, { transform: `translate(0px, 0px) rotate(${(i - (n - 1) / 2) * 1.5}deg)`, opacity: 1 }], { duration: T.gather, easing: "cubic-bezier(.4,0,.2,1)" }));
+        await wait(T.gather);
+        els.forEach((el, i) => { el.style.zIndex = String(10 - Math.abs(order[i] - (n - 1) / 2)); });
+        els.forEach((el, i) => anim(el, [{ transform: `translate(0px, 0px) rotate(${(i - (n - 1) / 2) * 1.5}deg)`, opacity: 1 }, { transform: at(order[i]), opacity: 1 }], { duration: T.fan }));
+        await wait(T.fan);
+        if (skipped || !live) { if (live) { landed(); buzz(20); await out(); } return; }
+        // The light: across the fan, each step longer, stopping on the chosen film.
+        const bySlot: HTMLElement[] = [];
+        els.forEach((el, i) => { bySlot[order[i]] = el; });
+        els.forEach((el) => dim(el, 0.5, 120));
+        let lit = -1;
+        const path = choosePath(n, order[w], T.gaps.length);
+        for (let k = 0; k < path.length; k++) {
+          const s = path[k];
+          if (lit >= 0 && lit !== s) { anim(bySlot[lit], [{ transform: at(lit, "translateY(-14px)") }, { transform: at(lit) }], { duration: 160 }); dim(bySlot[lit], 0.5, 160); }
+          anim(bySlot[s], [{ transform: at(s) }, { transform: at(s, "translateY(-14px)") }], { duration: 140 });
+          dim(bySlot[s], 0, 140);
+          lit = s;
+          buzz(4);
+          await wait(T.gaps[k]);
+          if (skipped || !live) break;
+        }
+        if (skipped || !live) { if (live) { landed(); buzz(20); await out(); } return; }
+        // The landing: the chosen film lifts forward; the rest sink back.
+        els.forEach((el, i) => { if (i !== w) anim(el, [{ transform: at(order[i]), opacity: 1 }, { transform: at(order[i], "translateY(26px) scale(.94)"), opacity: 0.14 }], { duration: T.lift }); });
+        els[w].style.zIndex = "40";
+        anim(els[w], [{ transform: at(order[w], "translateY(-14px)"), opacity: 1 }, { transform: LIFT, opacity: 1 }], { duration: T.lift });
+      } else {
+        // One film: straight to the lift.
+        anim(els[0], [{ transform: "translate(0px, 60px) scale(1)", opacity: 0 }, { transform: LIFT, opacity: 1 }], { duration: T.lift });
+      }
+      anim(pick, [{ opacity: 0, transform: "translateY(10px)" }, { opacity: 1, transform: "none" }], { duration: T.title, delay: Math.round(T.lift * 0.35) });
+      await wait(T.lift);
+      if (!live) return;
+      buzz(20);
+      // The title finishes setting a beat after the poster lands.
+      await wait(Math.max(0, Math.round(T.lift * 0.35) + T.title - T.lift));
+      if (!live) return;
+      if (skipped) landed();
+      await out();
+    })();
+    const esc = (e: KeyboardEvent) => { if (e.key === "Escape" || e.key === "Enter" || e.key === " ") skip.current?.(); };
+    window.addEventListener("keydown", esc);
+    return () => { live = false; finish(); window.removeEventListener("keydown", esc); };
+  }, []); // eslint-disable-line react-hooks/exhaustive-deps
+
+  const f = cards[Math.min(Math.max(winner, 0), cards.length - 1)];
+  if (typeof document === "undefined" || !f) return null;
+  return createPortal(
+    <div className="chs" ref={layer} role="status" aria-label={`Chosen: ${f.title}`} onPointerDown={() => skip.current?.()}>
+      <div className="chs-bg" />
+      {cards.map((c) => (
+        <div className="chs-card" key={c.slug} aria-hidden>
+          {c.posterUrl
+            ? /* eslint-disable-next-line @next/next/no-img-element */ <img src={tmdbSized(c.posterUrl, "w342") ?? c.posterUrl} alt="" decoding="async" />
+            : <span className="chs-ph">{c.title.slice(0, 1)}</span>}
+          <i className="chs-dim" />
+        </div>
+      ))}
+      <div className="chs-pick" aria-hidden>
+        {pct != null && <div className="chs-pct">{pct}<small>%</small><span>match</span></div>}
+        <div className="chs-t">{f.title}</div>
+        {meta && <div className="chs-s">{meta}</div>}
+      </div>
+    </div>,
+    document.body,
+  );
+}
