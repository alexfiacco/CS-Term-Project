@@ -9,3 +9,40 @@ export function ratingVerb(stars: number | null | undefined): RatingVerb | null
   if (stars == null || !Number.isFinite(stars)) return null;
   return stars >= 4.5 ? "loved" : stars >= 4 ? "really liked" : stars >= 3.5 ? "liked" : null;
 }
+
+/**
+ * Rule 1620 (owner, 2026-11-12: "loved" only for 4.5★ or 5★): a line that names several films with
+ * one verb ("Because you really liked Heat & Ronin") takes the verb of the LOWEST rating among the
+ * films it names, as rule 1603's "also" takes the lower of two. Null with no usable rating.
+ */
+export function lowestRatingVerb(ratings: readonly (number | null | undefined)[]): RatingVerb | null {
+  const known = ratings.filter((n): n is number => n != null && Number.isFinite(n) && n > 0);
+  return known.length ? ratingVerb(Math.min(...known)) : null;
+}
+
+const VERB_RANK: Record<RatingVerb, number> = { liked: 1, "really liked": 2, loved: 3 };
+
+/** The lowest of several verbs (the same order as the ratings), null with none known. */
+export function lowestVerb(verbs: readonly (string | null | undefined)[]): RatingVerb | null {
+  const known = verbs.filter((v): v is RatingVerb => v != null && v in VERB_RANK);
+  return known.length ? known.reduce((a, b) => (VERB_RANK[b] < VERB_RANK[a] ? b : a)) : null;
+}
+
+/**
+ * The verb of Picks' why line, "Because you <verb> X & Y" (rule 1620), from the films it names: each
+ * carries the verb /api/pick-why gave it (`ratingVerb` of their stars; a film liked with no stars is
+ * "liked"). An answer from before rule 1620 (no verb) keeps "loved", the line it always said.
+ */
+export function whyLineVerb(films: readonly { verb?: string | null }[]): RatingVerb {
+  return lowestVerb(films.map((f) => f.verb)) ?? "loved";
+}
+
+/**
+ * Which anchors the why line names (rule 1620): the films of theirs closest to the card, in that
+ * order, but films they loved (4.5★ or 5★) first: when any is among them, only loved films are
+ * named; otherwise the closest ones (4★, or liked with no stars) still are, never dropped.
+ */
+export function pickWhyAnchors<T extends { verb?: string | null }>(ranked: readonly T[], n = 2): T[] {
+  const loved = ranked.filter((a) => a.verb === "loved");
+  return (loved.length ? loved : ranked).slice(0, n);
+}
