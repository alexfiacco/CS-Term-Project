-    private static var warmed: [String: PublicFilm] = [:]
+    /// Films read this session, kept for ten minutes (film speed pass, rule 1810): fetched just
+    /// before their page opens (`warm`), and every film page that loads. A film opened again opens
+    /// with its whole head on it at once, not the seed and a wait for /api/public-film.
+    private static var warmed: [String: (film: PublicFilm, at: Date)] = [:]
+    private static let warmedFor: TimeInterval = 600
+    /// One read of a film's public page at a time: the page's own load joins a read already started
+    /// (by `init`, or `warm`) rather than asking again.
+    private static var reading: [String: Task<PublicFilm?, Never>] = [:]
+
+    private static func kept(_ slug: String) -> PublicFilm? {
+        guard let w = warmed[slug], Date().timeIntervalSince(w.at) < warmedFor else { return nil }
+        return w.film
+    }
+
+    /// The film's public page: kept, else the read under way, else a new read (which is kept).
+    static func publicFilm(_ slug: String) async -> PublicFilm? {
+        if let f = kept(slug) { return f }
+        if let t = reading[slug] { return await t.value }
+        let t = Task { @MainActor () -> PublicFilm? in
+            let f = await fetchPublic(slug)
+            if let f {
+                if warmed.count > 60 { warmed.removeAll() }
+                warmed[slug] = (f, Date())
+            }
+            reading[slug] = nil
+            return f
+        }
+        reading[slug] = t
+        return await t.value
+    }
 
     init(slug: String) {
         self.slug = slug
         // Every stored property set before the published film is.
         seed = FilmSeeds.card(slug)
-        film = Self.warmed[slug]
+        film = Self.kept(slug)
+        // The head's read goes out now, before the page asks for its token (it needs none);
+        // `load` joins it.
+        if film == nil { Task { _ = await Self.publicFilm(slug) } }
     }
 
     /// Fetches a film's page before it opens, waiting at most `wait` seconds; the fetch carries on
     /// past that, for the page's own load.
     static func warm(_ slug: String, wait: Double = 0.3) async {
-        guard warmed[slug] == nil else { return }
-        let fetch = Task { @MainActor in
-            if let f = await fetchPublic(slug) {
-                if warmed.count > 40 { warmed.removeAll() }
-                warmed[slug] = f
-            }
-        }
+        guard kept(slug) == nil else { return }
+        let fetch = Task { @MainActor in _ = await publicFilm(slug) }
         await withTaskGroup(of: Void.self) { group in
             group.addTask { await fetch.value }
             group.addTask { try? await Task.sleep(for: .seconds(wait)) }
@@ -524,7 +549,7 @@ final class FilmModel: ObservableObject {
         body = Self.baseBody(slug: slug, username: username, ownerKey: ownerKey)
