index 00000000..a0762372
--- /dev/null
+++ b/lib/poster-open.ts
@@ -0,0 +1,258 @@
+/**
+ * Opening a film grows the tapped poster into the film page's header poster (owner-approved,
+ * mockups/journeys/motion/b66-09-open-film; rule 1725). The OPEN only: closing stays exactly as it
+ * is (rule 1141: the sheet is dragged down at full width, nothing shrinks or flies home).
+ *
+ * Built once, in the shared path. Every film sheet is a PortalModal `sheet` with `fd-modal` (the
+ * one useFilmDetail/openFilmFromList renders, Discover's and Tonight's), so every caller gets it
+ * without passing anything: a capture-phase click listener notes what was tapped, and the sheet,
+ * as it mounts, asks for the poster that tap was on (`peekPosterSource`/`takePosterSource`). A
+ * caller that knows its poster can pass it outright with `notePosterSource(img)`.
+ *
+ * No poster (a deep link, a push, a restored sheet, a text link, a landscape still, a poster that
+ * has not loaded): the sheet opens as it always has (`sheet-up`). A film drilled into inside the
+ * sheet does not remount it, so it keeps its own change.
+ *
+ * Open, 450ms: the loaded poster's own pixels (drawn from the decoded <img>, so no flash) fly
+ * from its spot to the header poster's on cubic-bezier(.2,.7,.2,1), transform only; the sheet
+ * fades in over 220ms (linear), the backdrop over 450ms, and the blocks under the poster rise 24px
+ * over 380ms from 70ms. Then the header takes over: its poster shows the moment it has loaded (the
+ * flying copy stays over it until then), so nothing flashes. A slow page holds still too: the
+ * skeleton paints the poster in the loaded page's place (rule 1279), the header poster stays hidden
+ * under the flying copy across the skeleton-to-page swap (a class on the overlay, not on the node),
+ * and parts mounted mid-open (the real backdrop, the real blocks) pick the open up where it is
+ * instead of starting it again. Reduce Motion: a plain 200ms crossfade.
+ */
+
+export const OPEN_MS = 450;
+export const OPEN_EASE = "cubic-bezier(.2,.7,.2,1)";
+const FADE_MS = 220;
+const BACKDROP_MS = 450;
+const RISE_PX = 24;
+const RISE_MS = 380;
+const RISE_DELAY = 70;
+/** A tap older than this did not open the sheet that is mounting now. */
+const TAP_FRESH_MS = 900;
+/** The flying copy waits this long at most for the header's own poster to load. */
+const HANDOFF_MAX_MS = 1500;
+/** The sheet's body is waited for this long at most before the open goes without a flight. */
+const WAIT_MAX_MS = 250;
+
+/** What the rise moves: everything under the header poster. */
+const RISE_SEL = ".fd-hero-aside, .fd-hero-text, .fd-hero-stats, .fd-hero-float, .fd > :not(.fd-herowrap)";
+const BACKDROP_SEL = ".fd-hero-img";
+
+type Tap = { el: Element; x: number | null; y: number | null; at: number };
+let lastTap: Tap | null = null;
+let explicit: { img: HTMLImageElement; at: number } | null = null;
+let watching = false;
+
+/** Notes every tap, before the page's own handlers run, so the sheet they open can find its poster. */
+export function watchPosterTaps(): void {
+  if (watching || typeof document === "undefined") return;
+  watching = true;
+  document.addEventListener("click", (e) => {
+    const el = e.target instanceof Element ? e.target : null;
+    if (!el) return;
+    // A keyboard press has no point: the poster is then the one in the focused control.
+    const pointer = e.detail > 0 && (e.clientX !== 0 || e.clientY !== 0);
+    lastTap = { el, x: pointer ? e.clientX : null, y: pointer ? e.clientY : null, at: performance.now() };
+  }, true);
+}
+
+/** A caller that holds the tapped poster passes it in (else the tap watch finds it). */
+export function notePosterSource(img: HTMLImageElement | null): void {
+  explicit = img ? { img, at: performance.now() } : null;
+}
+
+const portrait = (img: HTMLImageElement): boolean => {
+  const r = img.getBoundingClientRect();
+  if (r.width < 24 || r.height < 30) return false;
+  return r.height >= r.width * 1.2;
+};
+
+const ready = (img: HTMLImageElement): boolean => img.complete && img.naturalWidth > 0 && !!(img.currentSrc || img.src);
+
+const onScreen = (r: DOMRect): boolean =>
+  r.bottom > 0 && r.right > 0 && r.top < window.innerHeight && r.left < window.innerWidth;
+
+/** The poster the tap was on: the tapped image, else the one portrait image in the nearest
+ *  control around the tap (the card, the row, the tile), the one under the finger when it holds
+ *  several. Nothing when that control is text only, or as big as the screen (a list, a page). */
+function posterFromTap(t: Tap): HTMLImageElement | null {
+  if (t.el instanceof HTMLImageElement && portrait(t.el)) return t.el;
+  const vw = window.innerWidth, vh = window.innerHeight;
+  let node: Element | null = t.el;
+  for (let up = 0; node && up < 6; up++, node = node.parentElement) {
+    if (node === document.body) break;
+    const box = node.getBoundingClientRect();
+    if (box.width * box.height > vw * vh * 0.5) break;
+    const imgs = Array.from(node.querySelectorAll("img")).filter(portrait);
+    if (imgs.length === 0) continue;
+    if (imgs.length === 1) return imgs[0];
+    if (t.x == null || t.y == null) return null;
+    const hit = imgs.find((i) => { const r = i.getBoundingClientRect(); return t.x! >= r.left && t.x! <= r.right && t.y! >= r.top && t.y! <= r.bottom; });
+    return hit ?? null;
+  }
+  return null;
+}
+
+export type PosterSource = { img: HTMLImageElement; rect: DOMRect; src: string; radius: string };
+
+function find(): PosterSource | null {
+  if (typeof window === "undefined") return null;
+  const now = performance.now();
+  let img: HTMLImageElement | null = null;
+  if (explicit && now - explicit.at <= TAP_FRESH_MS) img = explicit.img;
+  else if (lastTap && now - lastTap.at <= TAP_FRESH_MS) img = posterFromTap(lastTap);
+  if (!img || !img.isConnected || !ready(img)) return null;
+  // A poster inside a film sheet that is hidden under another sheet is not on screen.
+  if (img.closest(".modal-hidden")) return null;
+  const rect = img.getBoundingClientRect();
+  if (!onScreen(rect)) return null;
+  return { img, rect, src: img.currentSrc || img.src, radius: getComputedStyle(img).borderRadius };
+}
+
+export const prefersReducedMotion = (): boolean =>
+  typeof window !== "undefined" && !!window.matchMedia?.("(prefers-reduced-motion: reduce)").matches;
+
+/** How the film sheet mounting now should open: "fly" (from a poster), "fade" (from a poster,
+ *  Reduce Motion), or null (no poster: today's slide up). Does not use the tap up. */
+export function peekPosterSource(): "fly" | "fade" | null {
+  if (!find()) return null;
+  return prefersReducedMotion() ? "fade" : "fly";
+}
+
+/** The poster for the sheet mounting now, used up so a later sheet never flies from it. */
+export function takePosterSource(): PosterSource | null {
+  const s = find();
+  lastTap = null;
+  explicit = null;
+  return s;
+}
+
+/** Runs the open over `overlay` (the sheet's backdrop) and `sheet` (the panel). `onLanded` fires
+ *  once the header's own poster shows (the overlay then stops hiding it). Returns a cancel, for a
+ *  sheet closed mid-open: the flying copy goes at once, nothing plays backwards (rule 1141). */
+export function runPosterOpen(src: PosterSource, sheet: HTMLElement, z: number, onLanded: () => void): () => void {
+  const t0 = performance.now();
+  let done = false;
+  const anims: Animation[] = [];
+  const play = (el: Element, kf: Keyframe[], o: KeyframeAnimationOptions) => {
+    if (typeof (el as HTMLElement).animate !== "function") return;
+    const a = (el as HTMLElement).animate(kf, { fill: "backwards", ...o });
+    anims.push(a);
+    return a;
+  };
+
+  // The backdrop fades in and the blocks rise, each from where the open is now: a part mounted
+  // mid-open (the page landing over its skeleton) carries on rather than starting over.
+  const seen = new WeakSet<Element>();
+  const dress = () => {
+    const el = performance.now() - t0;
+    sheet.querySelectorAll(BACKDROP_SEL).forEach((n) => {
+      if (seen.has(n)) return; seen.add(n);
+      if (el >= BACKDROP_MS) return;
+      const a = play(n, [{ opacity: 0 }, { opacity: 1 }], { duration: BACKDROP_MS, easing: "linear" });
+      if (a) a.currentTime = el;
+    });
+    sheet.querySelectorAll(RISE_SEL).forEach((n) => {
+      if (seen.has(n)) return; seen.add(n);
+      if (el >= RISE_DELAY + RISE_MS) return;
+      const a = play(n, [{ opacity: 0, transform: `translateY(${RISE_PX}px)` }, { opacity: 1, transform: "none" }], { duration: RISE_MS, delay: RISE_DELAY, easing: OPEN_EASE });
+      if (a) a.currentTime = el;
+    });
+  };
+  dress();
+  const mo = typeof MutationObserver !== "undefined" ? new MutationObserver(dress) : null;
+  mo?.observe(sheet, { childList: true, subtree: true });
+  const stopWatch = window.setTimeout(() => mo?.disconnect(), RISE_DELAY + RISE_MS);
+  // The sheet itself fades in (the overlay's own dim fades as it always has).
+  play(sheet, [{ opacity: 0 }, { opacity: 1 }], { duration: FADE_MS, easing: "linear" });
+
+  // Where the header poster sits once the page is open: the skeleton puts it in the loaded page's
+  // place, so this is where the real one lands too. The sheet is not moved by the open, and the
+  // poster does not rise, so its box now is its box at the end. The sheet's body can mount a frame
+  // or two after the sheet (FilmMatch paints its skeleton from an effect): it is waited for, briefly.
+  let fly: HTMLCanvasElement | null = null;
+  let frame = 0;
+  const finish = () => {
+    if (done) return;
+    done = true;
+    src.img.style.visibility = "";
+    onLanded();
+    // The copy goes only once the overlay has stopped hiding the header poster (React's next
+    // render), so there is never a frame with neither.
+    const f = fly;
+    if (!f) return;
+    const overlay = sheet.parentElement;
+    let n = 0;
+    const drop = () => {
+      if (overlay?.classList.contains("modal-fo-flying") && sheet.isConnected && n++ < 30) { requestAnimationFrame(drop); return; }
+      requestAnimationFrame(() => f.remove());
+    };
+    requestAnimationFrame(drop);
+  };
+  const launch = (dst: HTMLElement, d: DOMRect) => {
+    const s = src.rect;
+    // The flying copy is the tapped poster's own decoded pixels, painted on a canvas at once: a new
+    // <img> of the same address can take a few frames to decode and flew blank.
+    const el = document.createElement("canvas");
+    fly = el;
+    el.className = "fo-fly";
+    el.setAttribute("aria-hidden", "true");
+    // Dressed as the header poster (its keyline, corner and shadow), so the hand-off changes nothing.
+    const cs = getComputedStyle(dst);
+    const bw = parseFloat(cs.borderTopWidth) || 0;
+    const dpr = Math.min(3, window.devicePixelRatio || 1);
+    const cw = Math.max(1, d.width - 2 * bw), ch = Math.max(1, d.height - 2 * bw);
+    el.width = Math.round(cw * dpr);
+    el.height = Math.round(ch * dpr);
+    const g = el.getContext("2d");
+    if (g) {
+      // object-fit: cover, centred, as the posters are drawn.
+      const nw = src.img.naturalWidth, nh = src.img.naturalHeight;
+      const k = Math.max(el.width / nw, el.height / nh);
+      try { g.drawImage(src.img, (el.width - nw * k) / 2, (el.height - nh * k) / 2, nw * k, nh * k); } catch { /* left blank */ }
+    }
+    el.style.cssText = `position:fixed;left:${d.left}px;top:${d.top}px;width:${d.width}px;height:${d.height}px;z-index:${z + 1};box-sizing:border-box;` +
+      `border-radius:${cs.borderRadius};border:${cs.borderTopWidth} ${cs.borderTopStyle} ${cs.borderTopColor};box-shadow:${cs.boxShadow};background:${cs.backgroundColor}`;
+    document.body.appendChild(el);
+    src.img.style.visibility = "hidden";
+    const flight = el.animate(
+      [{ transform: `translate(${s.left - d.left}px,${s.top - d.top}px) scale(${s.width / d.width},${s.height / d.height})` }, { transform: "none" }],
+      { duration: OPEN_MS, easing: OPEN_EASE, fill: "forwards" },
+    );
+    flight.finished.then(() => {
+      // Hand off to the header's own poster as soon as it has loaded (a seeded skeleton's usually has).
+      const tEnd = performance.now();
+      const check = () => {
+        if (done) return;
+        const real = sheet.querySelector<HTMLImageElement>("img.fd-hero-poster");
+        if ((real && ready(real)) || performance.now() - tEnd > HANDOFF_MAX_MS || !sheet.isConnected) { finish(); return; }
+        frame = requestAnimationFrame(check);
+      };
+      check();
+    }).catch(() => { /* cancelled: the sheet closed mid-open */ });
+  };
+  const seek = () => {
+    if (done) return;
+    const dst = sheet.querySelector<HTMLElement>(".fd-hero-poster");
+    const d = dst?.getBoundingClientRect();
+    if (dst && d && d.width >= 8 && onScreen(d)) { launch(dst, d); return; }
+    // No header poster on screen in time (a focus that scrolled the page to a section): the page
+    // fades and rises alone.
+    if (performance.now() - t0 > WAIT_MAX_MS) { finish(); return; }
+    frame = requestAnimationFrame(seek);
+  };
+  seek();
+
+  return () => {
+    window.clearTimeout(stopWatch);
+    mo?.disconnect();
+    cancelAnimationFrame(frame);
+    if (!done) { done = true; src.img.style.visibility = ""; }
+    fly?.remove();
+    anims.forEach((a) => a.cancel());
+  };
+}
