diff --git a/ios/Montage/Sources/Design/PosterFlight.swift b/ios/Montage/Sources/Design/PosterFlight.swift
new file mode 100644
index 00000000..b044ed4e
--- /dev/null
+++ b/ios/Montage/Sources/Design/PosterFlight.swift
@@ -0,0 +1,293 @@
+import SwiftUI
+import UIKit
+import UIKit.UIGestureRecognizerSubclass
+
+/// Opening a film grows the tapped poster into the film page's header poster (owner-approved,
+/// mockups/journeys/motion/b66-09-open-film; rule 1725). The OPEN only: the close stays the full-width
+/// swipe down on the full-screen cover (`FilmCover`, rule 1141). Never `.navigationTransition(.zoom)`,
+/// whose close shrinks the page.
+///
+/// Built once, in the shared path. Every poster that opens a film is a `filmZoomSource` (`OpeningPoster`),
+/// which marks its spot with a zero-cost UIKit probe; every film opened from a tab or a layer goes through
+/// `PageStack.openFilm`, which asks here for the poster the finger was just on (`capture`), the source rect,
+/// and a snapshot of it as it is on screen (already loaded, so it never flashes). The cover takes it as it
+/// appears (`FilmCoverPage`): no rise from the bottom; the page fades in over 0.22s, its blocks rise 24pt
+/// over 0.38s from 0.07s, the backdrop fades in over 0.45s (`posterOpenFade`), and the snapshot flies from
+/// the poster's spot to the header poster's (`posterHeader`) over 0.45s on cubic-bezier(.2,.7,.2,1), a
+/// transform only. Then the header poster shows (once its image is in, so there is no flash) and the copy
+/// goes. The seeded page puts its poster in the loaded page's place (rule 1279), so nothing jumps when the
+/// film lands.
+///
+/// No poster under the finger (a deep link, a push, a text link, a row, a film reopened): today's rise
+/// from the bottom. A film pushed inside a film page (`FilmZoom.open` there) slides in from the right as
+/// before: it never reaches `PageStack.openFilm`. Reduce Motion: no flight, a 0.2s crossfade. Haptic: only
+/// the light tick `openFilm` already gives.
+@MainActor
+final class PosterFlight: ObservableObject {
+    static let shared = PosterFlight()
+
+    static let duration: Double = 0.45
+    static let rise: CGFloat = 24
+    /// cubic-bezier(.2,.7,.2,1), the web's curve.
+    static let curve = (CGPoint(x: 0.2, y: 0.7), CGPoint(x: 0.2, y: 1))
+
+    /// The film whose header poster is hidden while its flying copy is on its way or over it.
+    @Published private(set) var landing: String?
+    /// The film whose tapped poster is lifted off its spot while it flies.
+    @Published private(set) var lifted: String?
+    /// When the open began (the backdrop's fade picks up from here, wherever the page is built).
+    private(set) var startedAt: Date?
+
+    struct Takeoff {
+        let slug: String
+        let snapshot: UIView
+        let from: CGRect
+        weak var window: UIWindow?
+        let at: Date
+    }
+    private var pending: Takeoff?
+    private var lastTouch: (point: CGPoint, at: Date)?
+    private var sources: [String: [Probe]] = [:]
+    private var headers: [String: [Probe]] = [:]
+    private var tracked = Set<ObjectIdentifier>()
+    /// The copy in the air.
+    private weak var flying: UIView?
+
+    struct Probe { weak var view: UIView?; let url: String? }
+
+    // MARK: Marks
+
+    fileprivate func register(_ v: UIView, slug: String, header: Bool, url: String?) {
+        if let w = v.window, !tracked.contains(ObjectIdentifier(w)) {
+            tracked.insert(ObjectIdentifier(w))
+            let note = TouchNote(target: nil, action: nil)
+            note.cancelsTouchesInView = false
+            note.delaysTouchesBegan = false
+            note.delaysTouchesEnded = false
+            w.addGestureRecognizer(note)
+        }
+        if header {
+            headers[slug] = (headers[slug] ?? []).filter { $0.view != nil && $0.view !== v } + [Probe(view: v, url: url)]
+        } else {
+            sources[slug] = (sources[slug] ?? []).filter { $0.view != nil && $0.view !== v } + [Probe(view: v, url: url)]
+        }
+    }
+
+    fileprivate func noteTouch(_ p: CGPoint) { lastTouch = (p, Date()) }
+
+    // MARK: The open
+
+    /// From `PageStack.openFilm`: the poster of `slug` the finger was just on, if there is one.
+    func capture(_ slug: String) {
+        pending = nil
+        guard !UIAccessibility.isReduceMotionEnabled,
+              let touch = lastTouch, Date().timeIntervalSince(touch.at) < 1 else { return }
+        lastTouch = nil
+        for p in sources[slug] ?? [] {
+            guard let v = p.view, let w = v.window else { continue }
+            let r = v.convert(v.bounds, to: w)
+            guard r.contains(touch.point), r.width > 20, r.height >= r.width * 1.2, w.bounds.intersects(r),
+                  let snap = w.resizableSnapshotView(from: r, afterScreenUpdates: false, withCapInsets: .zero) else { continue }
+            snap.isUserInteractionEnabled = false
+            pending = Takeoff(slug: slug, snapshot: snap, from: r, window: w, at: Date())
+            startedAt = Date()
+            landing = slug
+            // Never shown (the stack was busy): nothing stays hidden.
+            DispatchQueue.main.asyncAfter(deadline: .now() + 1.2) { [weak self] in
+                guard let self, let p = self.pending, p.slug == slug else { return }
+                self.pending = nil
+                if self.landing == slug { self.landing = nil }
+            }
+            return
+        }
+    }
+
+    /// The cover being built now opens from a poster.
+    var hasTakeoff: Bool { pending.map { Date().timeIntervalSince($0.at) < 1 } ?? false }
+
+    /// The takeoff, used up, for the cover appearing now.
+    func takeoff() -> Takeoff? {
+        defer { pending = nil }
+        guard let p = pending, Date().timeIntervalSince(p.at) < 1 else { return nil }
+        return p
+    }
+
+    /// Where the backdrop's fade starts for a page built now (1 when no open is under way).
+    func backdropFrom() -> Double {
+        guard let s = startedAt else { return 1 }
+        let t = Date().timeIntervalSince(s)
+        return t < Self.duration ? max(0, t / Self.duration) : 1
+    }
+
+    /// Flies `t` to the header poster of its film. `raise`: how far the page still sits below its place
+    /// (the rise has not started), so the copy lands where the header will be.
+    func launch(_ t: Takeoff, raise: CGFloat) {
+        seek(t, raise: raise, began: Date(), tries: 0)
+    }
+
+    /// cubic-bezier(.2,.7,.2,1) at `x` (0...1), solved for the curve's own x.
+    static func ease(_ x: Double) -> Double {
+        let x = min(1, max(0, x))
+        let (p1, p2) = curve
+        func b(_ t: Double, _ a: Double, _ c: Double) -> Double { 3 * a * t * (1 - t) * (1 - t) + 3 * c * t * t * (1 - t) + t * t * t }
+        var lo = 0.0, hi = 1.0
+        for _ in 0..<24 { let m = (lo + hi) / 2; if b(m, p1.x, p2.x) < x { lo = m } else { hi = m } }
+        return b((lo + hi) / 2, p1.y, p2.y)
+    }
+
+    private func seek(_ t: Takeoff, raise: CGFloat, began: Date, tries: Int) {
+        // The page's rise starts 0.07s in and runs 0.38s: how far it still sits below its place now.
+        let since = Date().timeIntervalSince(began)
+        let below = raise * CGFloat(1 - Self.ease((since - 0.07) / 0.38))
+        guard let w = t.window else { land(t.slug, nil); return }
+        let target = (headers[t.slug] ?? []).compactMap { p -> (CGRect, String?)? in
+            guard let v = p.view, v.window === w else { return nil }
+            let r = v.convert(v.bounds, to: w)
+            // A film pager's neighbours are built off to the side: only the one on screen.
+            guard r.width > 8, r.midX > 0, r.midX < w.bounds.width, r.intersects(w.bounds) else { return nil }
+            return (r.offsetBy(dx: 0, dy: -below), p.url)
+        }.last
+        guard let found = target else {
+            // The page's header is built a moment after the cover: waited for, briefly, else no flight.
+            if tries < 15 {
+                DispatchQueue.main.asyncAfter(deadline: .now() + 1.0 / 60) { [weak self] in self?.seek(t, raise: raise, began: began, tries: tries + 1) }
+            } else { land(t.slug, nil) }
+            return
+        }
+        let (to, url) = found
+        let snap = t.snapshot
+        let from = t.from
+        snap.frame = from
+        snap.layer.cornerRadius = Theme.radiusSm
+        snap.clipsToBounds = true
+        w.addSubview(snap)
+        flying = snap
+        lifted = t.slug
+        // Transform only: the snapshot keeps its own frame and is moved and scaled onto the header's.
+        let dx = to.midX - from.midX, dy = to.midY - from.midY
+        let sx = to.width / max(1, from.width), sy = to.height / max(1, from.height)
+        let a = UIViewPropertyAnimator(duration: Self.duration, controlPoint1: Self.curve.0, controlPoint2: Self.curve.1) {
+            snap.transform = CGAffineTransform(translationX: dx, y: dy).scaledBy(x: sx, y: sy)
+        }
+        a.addCompletion { [weak self] _ in self?.handOff(t.slug, snap: snap, url: url, waited: 0) }
+        a.startAnimation()
+    }
+
+    /// The header's own poster takes over once its image is in (at most 0.6s on), then the copy goes.
+    private func handOff(_ slug: String, snap: UIView, url: String?, waited: Double) {
+        let ready = url.flatMap(URL.init(string:)).map { ImagePipeline.shared.cached($0) != nil } ?? true
+        if !ready, waited < 0.6 {
+            DispatchQueue.main.asyncAfter(deadline: .now() + 0.05) { [weak self] in self?.handOff(slug, snap: snap, url: url, waited: waited + 0.05) }
+            return
+        }
+        land(slug, snap)
+    }
+
+    private func land(_ slug: String, _ snap: UIView?) {
+        if landing == slug { landing = nil }
+        if lifted == slug { lifted = nil }
+        startedAt = nil
+        // The header shows in SwiftUI's next pass; the copy goes just after, so there is never a gap.
+        if let snap { DispatchQueue.main.asyncAfter(deadline: .now() + 0.05) { snap.removeFromSuperview() } }
+    }
+
+    /// The cover closed mid-open: the copy goes at once, nothing plays backwards (rule 1141). Only the
+    /// flight for `slug`, and only while it is under way.
+    func cancel(_ slug: String) {
+        guard landing == slug || lifted == slug else { return }
+        flying?.removeFromSuperview()
+        landing = nil
+        lifted = nil
+        startedAt = nil
+    }
+}
+
+/// Notes where each touch begins, for `capture`, and never recognizes: it takes nothing from the app's
+/// own gestures and buttons.
+private final class TouchNote: UIGestureRecognizer {
+    override func touchesBegan(_ touches: Set<UITouch>, with event: UIEvent) {
+        if let t = touches.first, let w = view as? UIWindow ?? view?.window {
+            PosterFlight.shared.noteTouch(t.location(in: w))
+        }
+        state = .failed
+    }
+}
+
+/// A zero-size-cost UIKit view behind a poster: where it is on screen, read only when a film opens.
+private final class ProbeView: UIView {
+    var slug = ""
+    var header = false
+    var url: String?
+    override func didMoveToWindow() {
+        super.didMoveToWindow()
+        if window != nil { PosterFlight.shared.register(self, slug: slug, header: header, url: url) }
+    }
+}
+
+private struct PosterProbe: UIViewRepresentable {
+    let slug: String
+    let header: Bool
+    let url: String?
+
+    func makeUIView(context: Context) -> ProbeView {
+        let v = ProbeView()
+        v.isUserInteractionEnabled = false
+        v.backgroundColor = .clear
+        v.slug = slug; v.header = header; v.url = url
+        return v
+    }
+
+    func updateUIView(_ v: ProbeView, context: Context) {
+        guard v.slug != slug || v.url != url else { return }
+        v.slug = slug; v.url = url
+        if v.window != nil { PosterFlight.shared.register(v, slug: slug, header: header, url: url) }
+    }
+}
+
+/// A poster that opens its film: its spot, and lifted off it while its copy flies.
+private struct PosterSourceMark: ViewModifier {
+    let slug: String
+    @ObservedObject private var flight = PosterFlight.shared
+    func body(content: Content) -> some View {
+        content
+            .opacity(flight.lifted == slug ? 0 : 1)
+            .background(PosterProbe(slug: slug, header: false, url: nil))
+    }
+}
+
+/// The film page's header poster: where the copy lands, hidden until it has.
+private struct PosterHeaderMark: ViewModifier {
+    let slug: String
+    let url: String?
+    @ObservedObject private var flight = PosterFlight.shared
+    func body(content: Content) -> some View {
+        content
+            .opacity(flight.landing == slug ? 0 : 1)
+            .background(PosterProbe(slug: slug, header: true, url: url))
+    }
+}
+
+/// The backdrop fading in over the open, from wherever the open is when this part is built (a seeded
+/// header replaced by the loaded one carries on rather than starting over).
+private struct PosterOpenFade: ViewModifier {
+    @State private var shown: Double
+    init() { _shown = State(initialValue: PosterFlight.shared.backdropFrom()) }
+    func body(content: Content) -> some View {
+        content
+            .opacity(shown)
+            .onAppear {
+                guard shown < 1 else { return }
+                let rest = PosterFlight.duration * (1 - shown)
+                DispatchQueue.main.async { withAnimation(.linear(duration: rest)) { shown = 1 } }
+            }
+    }
+}
+
+extension View {
+    /// Rule 1725: a poster a film can fly out of.
+    func posterSource(_ slug: String) -> some View { modifier(PosterSourceMark(slug: slug)) }
+    /// Rule 1725: the film page's header poster, where the tapped poster lands. `url`: the image it shows.
+    func posterHeader(_ slug: String, url: String?) -> some View { modifier(PosterHeaderMark(slug: slug, url: url)) }
+    /// Rule 1725: the film page's backdrop, fading in as the poster flies.
+    func posterOpenFade() -> some View { modifier(PosterOpenFade()) }
+}
