@@ -0,0 +1,74 @@
+"use client";
+
+import { useLayoutEffect, useRef, useState } from "react";
+import { MenuPopover } from "./MenuPopover";
+
+export type ShowKey = "unseen" | "seen" | "all";
+const SHOW_ORDER: ShowKey[] = ["unseen", "seen", "all"];
+const SHOW_LABEL: Record<ShowKey, string> = { unseen: "Unseen", seen: "Seen", all: "All" };
+
+/** "34 unseen", "7 seen", "41 films": the count of what the grid holds, in the words of the current choice. */
+export function showWords(k: ShowKey, n: number): string {
+  const c = n.toLocaleString("en-US");
+  return k === "unseen" ? `${c} unseen` : k === "seen" ? `${c} seen` : `${c} film${n === 1 ? "" : "s"}`;
+}
+
+/**
+ * The one control row's count (owner-approved 2026-11-13, journeys/b74-list-controls B; rule 1800): "34 unseen ▾"
+ * in the UI face at 15 semibold, ink, with a muted ▾, 44 tall to tap. It opens the app's MenuPopover with
+ * Unseen / Seen / All and the check on the current one; the count follows the choice ("7 seen", "41 films").
+ * With nothing to switch (signed out, or nothing seen here) the same words, muted, with no ▾ and nothing to tap.
+ * Lane, theme and person pages (TagPage) and user lists (ListScreen); the iPhone's ShowCount is the same.
+ */
+export function ShowCount({ show, on, pending = false, total, text, onPick }: {
+  show: ShowKey; on: boolean; pending?: boolean; total: number;
+  /** In place of the count words (a list's search: "3 of 24 films"). */
+  text?: string;
+  onPick: (k: ShowKey) => void;
+}) {
+  const btn = useRef<HTMLButtonElement>(null);
+  const [open, setOpen] = useState(false);
+  const words = text ?? showWords(on ? show : "all", total);
+  if (!on) return <span className={`row-count${pending ? " skel" : ""}`}>{words}</span>;
+  return (
+    <>
+      <button ref={btn} type="button" className="row-count is-btn" aria-haspopup="menu" aria-expanded={open} aria-label={`${words}. Show`} onClick={() => setOpen((v) => !v)}>
+        {words}<span aria-hidden className="row-count-caret">▾</span>
+      </button>
+      {open && <MenuPopover anchor={btn.current} onClose={() => setOpen(false)} align="left" title="Show" label="Show"
+        items={SHOW_ORDER.map((k) => ({ key: k, label: SHOW_LABEL[k], checked: show === k, run: () => onPick(k) }))} />}
+    </>
+  );
+}
+
+/**
+ * Whether the one control row has to wrap (rule 1800, owner 2026-11-13): the count, then the right-hand group's
+ * natural width, 8 apart, wider than the row. Wrapped, the row takes `is-wrapped`: the group drops under the
+ * count, left-aligned, with the ⋯ pinned at the far right. Measured from the parts' own widths, so it unwraps
+ * when there is room again.
+ */
+export function useRowWrap<T extends HTMLElement>() {
+  const ref = useRef<T>(null);
+  const [wrapped, setWrapped] = useState(false);
+  const measure = () => {
+    const row = ref.current; if (!row) return;
+    const lead = row.firstElementChild as HTMLElement | null, group = row.querySelector<HTMLElement>(":scope > .row-ctl-r");
+    if (!lead || !group || lead === group) return;
+    const parts = [...group.children] as HTMLElement[];
+    const need = lead.offsetWidth + 8 + parts.reduce((w, c) => w + c.offsetWidth, 0) + 8 * Math.max(0, parts.length - 1);
+    const next = need > row.clientWidth;
+    setWrapped((v) => (v === next ? v : next));
+  };
+  // The row can mount after the page's first render (the skeleton first), so each render checks what is watched.
+  const watched = useRef<{ el: HTMLElement; ro: ResizeObserver } | null>(null);
+  useLayoutEffect(() => {
+    measure();
+    const row = ref.current;
+    if (watched.current?.el === row || typeof ResizeObserver === "undefined") return;
+    watched.current?.ro.disconnect();
+    watched.current = row ? { el: row, ro: new ResizeObserver(() => measure()) } : null;
+    if (row) watched.current!.ro.observe(row);
+  });
+  useLayoutEffect(() => () => watched.current?.ro.disconnect(), []);
+  return { ref, wrapped, className: wrapped ? " is-wrapped" : "" };
+}
