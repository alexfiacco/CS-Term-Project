+// MARK: - The one control row (rule 1800)
+
+/// Unseen / Seen / All, the count's menu on the one control row. The web's ShowKey (ShowCount.tsx).
+enum ShowKey: String, CaseIterable {
+    case unseen, seen, all
+    var label: String { rawValue.capitalized }
+    /// "34 unseen", "7 seen", "41 films": the count of what the grid holds, in the words of the choice.
+    func words(_ n: Int) -> String {
+        switch self {
+        case .unseen: return "\(n.grouped) unseen"
+        case .seen: return "\(n.grouped) seen"
+        case .all: return "\(n.grouped) film\(n == 1 ? "" : "s")"
+        }
+    }
+}
+
+/// The one control row's count (owner-approved 2026-11-13, CS-Term-Project mockups/journeys/b74-list-controls.png B;
+/// rule 1800), the web's ShowCount.tsx: "34 unseen ▾" in the UI face at 15 semibold, ink, with a muted ▾, 44 tall to
+/// tap. It opens the MenuPopover with Unseen / Seen / All and the check on the current one; the count follows the
+/// choice ("7 seen", "41 films"). With nothing to switch (signed out, or nothing seen here) the same words, muted,
+/// with no ▾ and nothing to tap. Lane, theme and person pages (TagPageScreen) and user lists (ListScreen).
+struct ShowCount: View {
+    let show: ShowKey
+    let on: Bool
+    let total: Int
+    /// In place of the count words (a list's search: "3 of 24 films").
+    var text: String? = nil
+    let pick: (ShowKey) -> Void
+    @State private var open = false
+
+    var body: some View {
+        let words = text ?? (on ? show : .all).words(total)
+        if on {
+            Button { haptic(); open = true } label: {
+                HStack(spacing: 4) {
+                    Text(words).font(Typo.body(.semibold)).foregroundStyle(Theme.ink).monospacedDigit().lineLimit(1)
+                    Text("▾").font(Typo.label()).foregroundStyle(Theme.muted)
+                }
+                .frame(minHeight: 44).contentShape(Rectangle())
+            }
+            .buttonStyle(.pressable)
+            .accessibilityLabel("\(words). Show")
+            .menuPopover(isPresented: $open) {
+                MenuPopover(title: "Show", items: ShowKey.allCases.map { k in
+                    MenuPopoverItem(id: k.rawValue, label: k.label, checked: k == show) { pick(k) }
+                }, close: { open = false })
+            }
+        } else {
+            Text(words).font(Typo.body(.medium)).foregroundStyle(Theme.muted).monospacedDigit().lineLimit(1)
+                .frame(minHeight: 44)
