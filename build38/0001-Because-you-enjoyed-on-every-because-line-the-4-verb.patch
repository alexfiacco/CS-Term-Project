+ * Which films Picks' "Because you enjoyed X & Y" names (rule 1620): the films of theirs closest to the
+ * card, in that order, but loved ones (4.5★ or 5★) first: when any is among them, only those are
+ * named; otherwise the closest (4★, or liked with no stars) still are, never dropped.
+ */
+export function pickWhyAnchors<T extends { rating?: number | null }>(ranked: readonly T[], n = 2): T[] {
