+export function useRatingAsk(slug: string | null | undefined, picked: number | null, predicted?: number | null) {
+  const saved = useGuess(slug, picked);
+  const verdict = saved?.verdict ?? (predicted != null && picked != null && picked > 0 ? defaultVerdict(pctShown(predicted), picked) : null);
+  const ask = slug && picked != null && picked > 0 ? askFor(picked, verdict) : null;
+  return { saved, verdict, ask };
+}
+
+/** "We said 82%. Called it." once, where a match showed (`predicted`, or `afterSave`: the first-time sheet, whose
+ *  rating is already saved, reads the save's own guess), then the question and the film's chips, "Optional". */
+export function RatingAsk({ slug, picked, predicted, afterSave = false }: { slug: string; picked: number; predicted?: number | null; afterSave?: boolean }) {
+  const { saved, verdict, ask } = useRatingAsk(slug, picked, predicted);
+  const pct = saved?.predicted ?? predicted;
+  return (
+    <div className="rating-ask">
+      {(predicted != null || (afterSave && saved)) && pct != null && verdict && <p className="rate-drawer-said">{saidLine(pctShown(pct), verdict)}</p>}
