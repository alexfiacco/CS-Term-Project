+/// rating (`RatingEditSheet`) and the first-time rating sheet, "When did you watch it?" after a first rating
+/// (`WatchedWhenSheet`, rule 1605). The web's `RatingAsk` (RatingLock.tsx).
+struct RatingAskBlock: View {
+    let slug: String
+    let stars: Double
+    /// The match % we showed before the rating, as shown; nil where matches are hidden.
+    var predicted: Int? = nil
+    /// The first-time sheet: the rating is already saved, so the save's own guess says the % (where matches show).
+    var afterSave = false
+    @ObservedObject private var guesses = GuessCheck.shared
+    @ObservedObject private var gate = ViewerRated.shared
+
+    /// The stars picked against the match % we showed (the saved guess at these stars, else the default table).
+    @MainActor static func verdict(slug: String, stars: Double, predicted: Int?) -> String? {
+        guard stars > 0 else { return nil }
+        if let g = GuessCheck.shared.guess(slug, rating: stars) { return g.verdict }
+        return predicted.map { RatingChips.defaultVerdict(pct: $0, stars: stars) }
+    }
+    /// Whether the block asks at all (a called 3 to 3.5 asks nothing), so the take after it can skip its own chips.
+    @MainActor static func asks(slug: String, stars: Double?, predicted: Int? = nil) -> Bool {
+        guard let stars else { return false }
+        return RatingChips.ask(stars: stars, verdict: verdict(slug: slug, stars: stars, predicted: predicted)) != nil
+    }
+
+    var body: some View {
+        let verdict = Self.verdict(slug: slug, stars: stars, predicted: predicted)
+        let saved = afterSave && gate.matchShown ? guesses.guess(slug, rating: stars).map { MatchFormat.shownInt(Double($0.predicted)) } : nil
